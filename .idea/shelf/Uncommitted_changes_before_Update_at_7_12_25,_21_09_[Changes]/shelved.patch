<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\n\n<?import javafx.scene.control.*?>\n<?import javafx.scene.image.*?>\n<?import javafx.scene.layout.*?>\n<?import javafx.scene.text.*?>\n<?import javafx.geometry.Insets?>\n\n<!-- StackPane: Contenedor principal que centra el contenido, fuente https://www.geeksforgeeks.org/java/javafx-stackpane-class/ -->\n<StackPane xmlns=\"http://javafx.com/javafx/17.0.2-ea\" xmlns:fx=\"http://javafx.com/fxml/1\"\n           fx:controller=\"org.borghisales.salessysten.controllers.MainController\"\n           prefHeight=\"600.0\" prefWidth=\"450.0\"> <!-- prefHeight y prefWidth definen el tamaño de la ventana -->\n\n    <!-- VBox: Contenedor vertical que apila elementos uno debajo del otro -->\n    <VBox alignment=\"CENTER\" spacing=\"20\"> <!-- spacing=\"20\" pone 20 pixeles de separación entre cada elemento -->\n\n        <!-- Padding: Márgenes internos (30 pixeles en todos los lados) -->\n        <padding>\n            <Insets top=\"30\" bottom=\"30\" left=\"30\" right=\"30\"/>\n        </padding>\n\n      <HBox alignment=\"CENTER\" spacing=\"10\"> <!-- preserveRatio mantiene la proporción original de la imagen -->\n            <ImageView fitHeight=\"150\" fitWidth=\"150\" pickOnBounds=\"true\" preserveRatio=\"true\">\n                <image>\n                    <Image url=\"@../../../../images/logosinfondo.png\" /> <!-- logo sin fondo y con buena calidad, detalles mínimos pero lindos -->\n                </image>\n            </ImageView>\n        </HBox>\n\n        <HBox alignment=\"CENTER\" spacing=\"10\">\n\n            <Label alignment=\"CENTER\" text=\"Sistema de Ventas\" underline=\"true\">\n                <font>\n                    <Font size=\"28.0\" />\n                </font>\n            </Label>\n        </HBox>\n\n        <VBox alignment=\"CENTER\" spacing=\"10\" prefWidth=\"250\">\n\n            <Label alignment=\"CENTER\" text=\"Usuario\" textAlignment=\"CENTER\">\n                <font>\n                    <Font size=\"24.0\" />\n                </font>\n            </Label>\n\n            <!-- TextField: Campo de texto donde el usuario escribe su nombre -->\n            <TextField fx:id=\"user\" prefWidth=\"200\"/>\n        </VBox>\n\n        <VBox alignment=\"CENTER\" spacing=\"10\" prefWidth=\"250\">\n\n            <Label alignment=\"CENTER\" text=\"Contraseña\">\n                <font>\n                    <Font size=\"24.0\" />\n                </font>\n            </Label>\n\n            <!-- PasswordField: Campo de texto que oculta lo que se escribe para contraseñas -->\n            <PasswordField fx:id=\"password\" prefWidth=\"200\"/>\n        </VBox>\n\n        <!-- Botón para iniciar sesión -->\n        <Button mnemonicParsing=\"false\" onAction=\"#signIn\" prefHeight=\"33.0\" prefWidth=\"119.0\" text=\"INICIAR SESIÓN\">\n            <VBox.margin>\n                <Insets top=\"20\"/>\n            </VBox.margin>\n        </Button>\n\n    </VBox>\n\n</StackPane>
