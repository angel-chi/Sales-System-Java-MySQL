<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.CustomerController"
           prefHeight="650.0" prefWidth="900.0">

    <VBox alignment="TOP_CENTER" spacing="20">
        <padding>
            <Insets top="30" bottom="30" left="40" right="40"/>
        </padding>

        <!-- TÍTULO -->
        <Label text="GESTIÓN DE CLIENTES" underline="true">
            <font>
                <Font size="24"/>
            </font>
        </Label>

        <!-- FORMULARIO CON BOTONES -->
        <GridPane hgap="15" vgap="15" alignment="CENTER" maxWidth="700">

            <!-- Fila 1: DNI -->
            <Label text="DNI:" underline="true" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <font>
                    <Font size="17.0"/>
                </font>
            </Label>
            <TextField fx:id="dni" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="AÑADIR" onAction="#addCustomer" prefWidth="130.0" prefHeight="32.0"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <!-- Fila 2: NOMBRE -->
            <Label text="NOMBRE:" underline="true" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <font>
                    <Font size="17.0"/>
                </font>
            </Label>
            <TextField fx:id="name" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Button text="ACTUALIZAR" onAction="#updateCustomer" prefWidth="130.0" prefHeight="32.0"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>

            <!-- Fila 3: DIRECCIÓN -->
            <Label text="DIRECCIÓN:" underline="true" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <font>
                    <Font size="17.0"/>
                </font>
            </Label>
            <TextField fx:id="address" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button text="BORRAR" onAction="#deleteCustomer" prefWidth="130.0" prefHeight="32.0"
                    GridPane.columnIndex="2" GridPane.rowIndex="2"/>

            <!-- Fila 4: ESTADO -->
            <Label text="ESTADO:" underline="true" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <font>
                    <Font size="17.0"/>
                </font>
            </Label>
            <ComboBox fx:id="cbState" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Button text="LIMPIAR CELDAS" onAction="#cleanCellsScreen" prefWidth="130.0" prefHeight="32.0"
                    GridPane.columnIndex="2" GridPane.rowIndex="3"/>

        </GridPane>

        <Separator prefWidth="800.0"/>

        <!-- TABLA -->
        <TableView fx:id="tableCustomers" prefHeight="280" prefWidth="800">
            <columns>
                <TableColumn fx:id="colId" text="IdCliente" prefWidth="100"/>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                <TableColumn fx:id="colEmail" text="E-mail" prefWidth="133"/>
                <TableColumn fx:id="colName" text="Nombre" prefWidth="133"/>
                <TableColumn fx:id="colAddress" text="Dirección" prefWidth="133"/>
                <TableColumn fx:id="colState" text="Estado" prefWidth="133"/>
            </columns>
        </TableView>

    </VBox>

</StackPane>