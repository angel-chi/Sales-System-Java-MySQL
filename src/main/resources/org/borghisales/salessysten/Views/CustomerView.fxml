<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.CustomerController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="650.0">
         <children>
            <Button layoutX="563.0" layoutY="14.0" mnemonicParsing="false" onAction="#backToMenu" text="Regresar" />
            <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addCustomer" prefHeight="32.0" prefWidth="101.0" text="AGREGAR" />
            <TableView fx:id="tableCustomers" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="26.0" AnchorPane.rightAnchor="26.0" AnchorPane.topAnchor="228.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="idCliente" />
                  <TableColumn fx:id="colDni" prefWidth="111.0" text="correo" />
                  <TableColumn fx:id="colName" prefWidth="124.0" text="nombre" />
                  <TableColumn fx:id="colAddress" prefWidth="124.0" text="dirección" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Label layoutX="38.0" layoutY="65.0" prefHeight="24.0" prefWidth="80.0" text="CORREO:" underline="true">
               <font>
                   <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Label layoutX="33.0" layoutY="94.0" prefHeight="24.0" prefWidth="90.0" text="NOMBRE:" underline="true">
               <font>
                   <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Label layoutX="18.0" layoutY="123.0" prefHeight="26.0" prefWidth="102.0" text="DIRECCION:" underline="true">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <TextField fx:id="dni" layoutX="120.0" layoutY="64.0" prefHeight="25.0" prefWidth="304.0" />
            <TextField fx:id="name" layoutX="120.0" layoutY="93.0" prefHeight="25.0" prefWidth="304.0" />
            <TextField fx:id="address" layoutX="121.0" layoutY="123.0" prefHeight="25.0" prefWidth="304.0" />
            <Button layoutX="458.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateCustomer" prefHeight="32.0" prefWidth="101.0" text="ACTUALIZAR" />
            <Button layoutX="458.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteCustomer" prefHeight="32.0" prefWidth="101.0" text="ELIMINAR" />
            <Button layoutX="458.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="125.0" text="LIMPIAR CELDA" />
            <ComboBox fx:id="cbState" layoutX="121.0" layoutY="166.0" prefHeight="25.0" prefWidth="304.0" />
            <Label layoutX="40.0" layoutY="163.0" prefHeight="17.0" prefWidth="75.0" text="ESTADO:" underline="true">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="180.0" layoutY="10.0" prefHeight="30.0" prefWidth="255.0" text="GESTIÓN DE CLIENTES" underline="true">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</StackPane>
