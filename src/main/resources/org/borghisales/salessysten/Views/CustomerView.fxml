            </Label>
            <Label alignment="CENTER" layoutX="120.0" layoutY="10.0" prefHeight="30.0" prefWidth="350.0" text="GESTIÓN DE CLIENTES" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Button fx:id="back" layoutX="30.0" layoutY="12.0" mnemonicParsing="false" onAction="#back" text="ATRAS" />
