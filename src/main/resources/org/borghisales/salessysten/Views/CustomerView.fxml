<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.CustomerController">
    <children>
        <AnchorPane layoutX="10.0" layoutY="10.0" prefHeight="474.0" prefWidth="653.0">
            <children>
                <Button layoutX="460.0" layoutY="52.0" mnemonicParsing="false" onAction="#addCustomer" prefHeight="32.0" prefWidth="140.0" text="AÑADIR" />
                <TableView fx:id="tableCustomers" layoutX="26.0" layoutY="228.0" prefHeight="221.0" prefWidth="602.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="120.0" text="idUsuario" />
                        <TableColumn fx:id="colDni" prefWidth="111.0" text="Usuario" />
                        <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre" />
                        <TableColumn fx:id="colAddress" prefWidth="124.0" text="Dirección" />
                        <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
                    </columns>
                </TableView>
                <Label alignment="CENTER_RIGHT" layoutX="30.0" layoutY="71.0" prefHeight="17.0" prefWidth="120.0" text="USUARIO:" underline="true">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <Label alignment="CENTER_RIGHT" layoutX="30.0" layoutY="97.0" prefHeight="17.0" prefWidth="120.0" text="NOMBRE:" underline="true">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <Label alignment="CENTER_RIGHT" layoutX="30.0" layoutY="123.0" prefHeight="26.0" prefWidth="120.0" text="DIRECCIÓN:" underline="true">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <TextField fx:id="dni" layoutX="160.0" layoutY="64.0" prefHeight="25.0" prefWidth="270.0" />
                <TextField fx:id="name" layoutX="160.0" layoutY="93.0" prefHeight="25.0" prefWidth="270.0" />
                <TextField fx:id="address" layoutX="160.0" layoutY="123.0" prefHeight="25.0" prefWidth="270.0" />
                <Button layoutX="460.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateCustomer" prefHeight="32.0" prefWidth="140.0" text="ACTUALIZAR" />
                <Button layoutX="460.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteCustomer" prefHeight="32.0" prefWidth="140.0" text="ELIMINAR" />
                <Button layoutX="460.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="140.0" text="LIMPIAR CAMPOS" />
                <ComboBox fx:id="cbState" layoutX="160.0" layoutY="166.0" prefHeight="25.0" prefWidth="270.0" />
                <Label alignment="CENTER_RIGHT" layoutX="30.0" layoutY="163.0" prefHeight="17.0" prefWidth="120.0" text="ESTADO:" underline="true">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="204.0" layoutY="10.0" prefHeight="30.0" prefWidth="255.0" text="GESTIÓN DE CLIENTES" underline="true">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>