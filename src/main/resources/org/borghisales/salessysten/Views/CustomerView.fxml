<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.CustomerController">
   <children>
      <AnchorPane layoutX="10.0" layoutY="10.0" prefHeight="800.0" prefWidth="1000.0" stylesheets="@CSS/MainView.css">
         <children>
            <Button layoutX="509.0" layoutY="67.0" mnemonicParsing="false" onAction="#addCustomer" prefHeight="54.0" prefWidth="200.0" style="-fx-background-color: #43d051; -fx-text-fill: #fff;" text="AGREGAR" />
            <TableView fx:id="tableCustomers" layoutX="44.0" layoutY="339.0" prefHeight="375.0" prefWidth="913.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="Identificador" />
                  <TableColumn fx:id="colDni" prefWidth="111.0" text="Usuario" />
                  <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre" />
                   <TableColumn fx:id="colMembresia" prefWidth="122.0" text="Membresía" />
                  <TableColumn fx:id="colAddress" prefWidth="124.0" text="Dirección" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
               </columns>
            </TableView>
            <Label layoutX="30.0" layoutY="78.0" prefHeight="17.0" prefWidth="54.0" text="ID:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="30.0" layoutY="125.0" prefHeight="21.0" prefWidth="90.0" text="NOMBRE:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="30.0" layoutY="166.0" prefHeight="26.0" prefWidth="107.0" text="DIRECCION:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="dni" layoutX="163.0" layoutY="70.0" prefHeight="36.0" prefWidth="304.0" />
            <TextField fx:id="name" layoutX="163.0" layoutY="118.0" prefHeight="36.0" prefWidth="304.0" />
            <TextField fx:id="address" layoutX="163.0" layoutY="161.0" prefHeight="36.0" prefWidth="304.0" />
            <Button layoutX="509.0" layoutY="131.0" mnemonicParsing="false" onAction="#updateCustomer" prefHeight="54.0" prefWidth="200.0" style="-fx-background-color: #439dd0; -fx-text-fill: #fff;" text="ACTUALIZAR" />
            <Button layoutX="509.0" layoutY="197.0" mnemonicParsing="false" onAction="#deleteCustomer" prefHeight="54.0" prefWidth="200.0" style="-fx-background-color: #d04343; -fx-text-fill: #fff;" text="ELIMINAR" />
            <Button layoutX="509.0" layoutY="263.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="54.0" prefWidth="200.0" style="-fx-background-color: #4b4b4b; -fx-text-fill: #fff;" text="LIMPIAR" />
            <ComboBox fx:id="cbState" layoutX="163.0" layoutY="209.0" prefHeight="36.0" prefWidth="304.0" />
            <Label layoutX="30.0" layoutY="217.0" prefHeight="21.0" prefWidth="100.0" text="ESTADO:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="357.0" layoutY="6.0" prefHeight="30.0" prefWidth="304.0" text="GESTION DE CLIENTES" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>

             <Label layoutX="30.0" layoutY="250.0" prefHeight="21.0" prefWidth="130.0" text="MEMBRESIA:" underline="true">
                 <font>
                     <Font size="17.0" />
                 </font>
             </Label>
             <ComboBox fx:id="cbMembresia" layoutX="163.0" layoutY="250.0" prefHeight="36.0" prefWidth="304.0" />

         </children>
      </AnchorPane>
   </children>
</AnchorPane>
