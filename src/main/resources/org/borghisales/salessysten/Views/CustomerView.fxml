<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.text.Text?>
<AnchorPane prefHeight="484.0" prefWidth="663.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.CustomerController">
    <Button text="Cerrar ventana" AnchorPane.topAnchor="10" AnchorPane.rightAnchor="10" prefHeight="35" prefWidth="120" onAction="#exitWindow" />
    <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <Label text="Control de clientes" underline="true">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <HBox alignment="TOP_CENTER" spacing="30.0" AnchorPane.topAnchor="60.0">

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="80.0" prefWidth="80.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>

                <Label text="Usuario:" underline="true" style="-fx-font-weight: bold; -fx-font-size: 15px;" GridPane.rowIndex="0" />
                <Label text="Nombre:" underline="true" style="-fx-font-weight: bold; -fx-font-size: 15px;" GridPane.rowIndex="1" />
                <Label text="Dirección:" underline="true" style="-fx-font-weight: bold; -fx-font-size: 15px;" GridPane.rowIndex="2" />
                <Label text="Estado:" underline="true" style="-fx-font-weight: bold; -fx-font-size: 15px;" GridPane.rowIndex="3" />

                <TextField fx:id="dni" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="name" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="address" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbState" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.topAnchor="60.0">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Ingrese id del cliente " style="-fx-font-weight: bold; -fx-font-size: 15px;" GridPane.rowIndex="0"/>
                    <TextField fx:id="idSearch" prefHeight="25" GridPane.columnIndex="1"/>
                    <Button onAction="#searchCustomer" prefHeight="35" prefWidth="120" text="Buscar" />
                </HBox>
                <Button onAction="#addCustomer" prefHeight="35.0" prefWidth="120.0" text="Añadir" />
                <Button onAction="#updateCustomer" prefHeight="35.0" prefWidth="120.0" text="Actualizar" />
                <Button onAction="#deleteCustomer" prefHeight="35.0" prefWidth="120.0" text="Eliminar" />
                <Button onAction="#cleanCellsScreen" prefHeight="35.0" prefWidth="120.0" text="Limpiar Celdas" />
            </VBox>
        </HBox>

        <TableView fx:id="tableCustomers" prefHeight="221.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="idCliente" />
                <TableColumn fx:id="colDni" prefWidth="120.0" text="Usuario" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="colAddress" prefWidth="150.0" text="Dirección" />
                <TableColumn fx:id="colState" prefWidth="100.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</AnchorPane>