<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.CustomerController"
            prefWidth="700" prefHeight="500">

    <!-- TITULO SUPERIOR -->
    <top>
        <Label text="GESTIÓN DE CLIENTES" BorderPane.alignment="CENTER">
            <font>
                <Font size="24" />
            </font>
        </Label>
    </top>

    <!-- FORMULARIO Y BOTONES -->
    <center>
        <VBox spacing="15" padding="20">
            <children>

                <!-- FORMULARIO DE ENTRADA -->
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="80"/>
                    </columnConstraints>

                    <children>
                        <Label text="DNI:" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <font><Font size="16"/></font>
                        </Label>
                        <TextField fx:id="dni" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <font><Font size="16"/></font>
                        </Label>
                        <TextField fx:id="name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Dirección:" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <font><Font size="16"/></font>
                        </Label>
                        <TextField fx:id="address" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Estado:" GridPane.rowIndex="3" GridPane.columnIndex="0">
                            <font><Font size="16"/></font>
                        </Label>
                        <ComboBox fx:id="cbState" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <!-- BOTONES CRUD -->
                <HBox spacing="15">
                    <children>
                        <Button text="AGREGAR"     onAction="#addCustomer"      />
                        <Button text="ACTUALIZAR"  onAction="#updateCustomer"   />
                        <Button text="ELIMINAR"    onAction="#deleteCustomer"   />
                        <Button text="LIMPIAR"     onAction="#cleanCellsScreen" />
                    </children>
                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tableCustomers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" />
                        <TableColumn fx:id="colDni" text="DNI" />
                        <TableColumn fx:id="colName" text="Nombre" />
                        <TableColumn fx:id="colAddress" text="Dirección" />
                        <TableColumn fx:id="colState" text="Estado" />
                    </columns>
                </TableView>

            </children>
        </VBox>
    </center>

</BorderPane>
