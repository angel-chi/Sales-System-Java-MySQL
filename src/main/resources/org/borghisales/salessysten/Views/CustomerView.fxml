<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="643.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.CustomerController">

    <!-- PARTE SUPERIOR-->
    <top>
        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" maxWidth="Infinity" prefHeight="0.0" prefWidth="687.0" text="ADMINISTRACIÓN DE CLIENTES" underline="true" BorderPane.alignment="CENTER">
            <font>
                <Font size="20.0" />
            </font>
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </Label>
    </top>

    <center>
        <VBox fillWidth="true" prefHeight="500.0" prefWidth="700.0" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
            <HBox prefWidth="641.0" spacing="20">
                <!-- FORMULARIO -->
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                    </columnConstraints>

                    <!-- IDENTIFICACIÓN -->
                    <Label text="IDENTIFICACIÓN:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="DNI" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- NOMBRE -->
                    <Label text="NOMBRE:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="name" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <!-- DIRECCIÓN -->
                    <Label text="DIRECCIÓN:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="address" prefHeight="25.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- ESTADO -->
                    <Label text="ESTADO:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <ComboBox fx:id="cbState" prefHeight="25.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <!-- BOTONES DE ACCIÓN -->
                <VBox alignment="TOP_CENTER" spacing="10">
                    <Button onAction="#addCustomer" prefHeight="32.0" prefWidth="140.0" text="AÑADIR" />
                    <Button onAction="#updateCustomer" prefHeight="32.0" prefWidth="140.0" text="ACTUALIZAR" />
                    <Button onAction="#deleteCustomer" prefHeight="32.0" prefWidth="140.0" text="ELIMINAR" />
                    <Button onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="168.0" text="LIMPIAR CELDAS" />
                </VBox>
            </HBox>

            <!-- TABLA DE CLIENTES -->
            <TableView fx:id="tableCustomers" prefHeight="248.0" prefWidth="618.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="120.0" text="ID de Cliente" />
                    <TableColumn fx:id="colDni" prefWidth="111.0" text="Identificación" />
                    <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre" />
                    <TableColumn fx:id="colAddress" prefWidth="124.0" text="Dirección" />
                    <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
                </columns>
            </TableView>

        </VBox>
    </center>
</BorderPane>
