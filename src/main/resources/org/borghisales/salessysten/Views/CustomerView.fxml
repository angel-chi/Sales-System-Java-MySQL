<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.CustomerController"
            prefWidth="800.0" prefHeight="500.0">

    <!-- TÍTULO SUPERIOR -->
    <top>
        <Label text="ADMINISTRACIÓN DE CLIENTES"
               underline="true"
               maxWidth="Infinity"
               BorderPane.alignment="CENTER">
            <font>
                <Font size="20.0"/>
            </font>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </Label>
    </top>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="15" fillWidth="true">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <!-- FORMULARIO + BOTONES -->
            <HBox spacing="20">
                <!-- FORMULARIO -->
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                    </columnConstraints>

                    <!-- IDENTIFICACIÓN -->
                    <Label text="IDENTIFICACIÓN" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <font><Font size="17.0"/></font>
                    </Label>
                    <TextField fx:id="DNI"
                               prefHeight="25.0"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <!-- NOMBRE -->
                    <Label text="NOMBRE" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <font><Font size="17.0"/></font>
                    </Label>
                    <TextField fx:id="name"
                               prefHeight="25.0"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <!-- DIRECCIÓN -->
                    <Label text="DIRECCIÓN" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <font><Font size="17.0"/></font>
                    </Label>
                    <TextField fx:id="address"
                               prefHeight="25.0"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <!-- ESTADO -->
                    <Label text="ESTADO" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <font><Font size="17.0"/></font>
                    </Label>
                    <ComboBox fx:id="cbState"
                              prefHeight="25.0"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"/>
                </GridPane>

                <!-- BOTONES DE ACCIÓN -->
                <VBox spacing="10" alignment="TOP_CENTER">
                    <Button text="AÑADIR"
                            onAction="#addCustomer"
                            prefWidth="140.0" prefHeight="32.0"/>
                    <Button text="ACTUALIZAR"
                            onAction="#updateCustomer"
                            prefWidth="140.0" prefHeight="32.0"/>
                    <Button text="ELIMINAR"
                            onAction="#deleteCustomer"
                            prefWidth="140.0" prefHeight="32.0"/>
                    <Button text="LIMPIAR CELDAS"
                            onAction="#cleanCellsScreen"
                            prefWidth="140.0" prefHeight="32.0"/>
                </VBox>
            </HBox>

            <!-- TABLA DE CLIENTES -->
            <TableView fx:id="tableCustomers"
                       prefHeight="250.0"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="120.0" text="ID de Cliente"/>
                    <TableColumn fx:id="colDni" prefWidth="111.0" text="Identificación"/>
                    <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre"/>
                    <TableColumn fx:id="colAddress" prefWidth="124.0" text="Dirección"/>
                    <!-- OJO: aquí corrijo el nombre, en tu FXML original hay un espacio en 'colSt ate' -->
                    <TableColumn fx:id="colState" prefWidth="122.0" text="Estado"/>
                </columns>
            </TableView>

        </VBox>
    </center>
</BorderPane>
