<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #2c2c2c, #1e1e1e);"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController">

    <children>
        <VBox fx:id="loginContainer" alignment="CENTER" spacing="20.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <Label text="SISTEMA DE VENTAS"
                   style="-fx-text-fill: #f2f2f2; -fx-font-weight: bold;">
                <font>
                    <Font name="Segoe UI Semibold" size="34.0" />
                </font>
                <effect>
                    <DropShadow color="#0000004d" height="10.0" radius="4.5" width="10.0" />
                </effect>
            </Label>

            <Separator maxWidth="300" style="-fx-background-color: #555; -fx-opacity: 0.3;"/>

            <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../../images/usuarioInicio.png" />
                </image>
                <effect>
                    <DropShadow color="#00000066" radius="10" />
                </effect>
            </ImageView>

            <VBox alignment="CENTER" spacing="15" maxWidth="300">

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="ID VENDEDOR" style="-fx-text-fill: #dcdcdc; -fx-font-weight: bold;">
                        <font><Font name="Segoe UI" size="13.0" /></font>
                    </Label>
                    <TextField fx:id="user"
                               prefHeight="40.0"
                               promptText="Ingrese su ID"
                               style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-prompt-text-fill: #888;" />
                </VBox>

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="CONTRASEÑA" style="-fx-text-fill: #dcdcdc; -fx-font-weight: bold;">
                        <font><Font name="Segoe UI" size="13.0" /></font>
                    </Label>

                    <AnchorPane maxWidth="300">
                        <TextField fx:id="passwordText"
                                   visible="false" managed="false"
                                   prefHeight="40.0" prefWidth="300.0"
                                   promptText="Ingrese su contraseña"
                                   style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 40 10 10; -fx-prompt-text-fill: #888;"
                                   AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

                        <PasswordField fx:id="password"
                                       prefHeight="40.0" prefWidth="300.0"
                                       promptText="Ingrese su contraseña"
                                       style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 40 10 10; -fx-prompt-text-fill: #888;"
                                       AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

                        <ToggleButton fx:id="btnTogglePass"
                                      onAction="#togglePasswordVisibility"
                                      prefHeight="30.0" prefWidth="30.0"
                                      style="-fx-background-color: transparent; -fx-cursor: hand;"
                                      AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                            <graphic>
                                <ImageView fx:id="imgEye" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/ojoCerraDos.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </ToggleButton>
                    </AnchorPane>
                </VBox>
            </VBox>

            <Region prefHeight="10" />

            <Button fx:id="btnLogin"
                    text="INGRESAR"
                    mnemonicParsing="false"
                    onAction="#signIn"
                    prefHeight="40.0" prefWidth="180.0"
                    style="-fx-background-color: #3a3a3a; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: #555; -fx-border-radius: 8;">
                <font>
                    <Font name="Segoe UI Semibold" size="16.0" />
                </font>
                <effect>
                    <DropShadow color="#00000040" offsetY="3" />
                </effect>
            </Button>

        </VBox>
    </children>
</AnchorPane>