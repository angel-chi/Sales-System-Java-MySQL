<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.MainController">
    <children>
        <ImageView fitHeight="650.0" fitWidth="650.0" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0">
            <image>
                <Image url="@../../../../images/fondologin.jpg"/>
            </image>
        </ImageView>
        <ImageView fitHeight="150.0" fitWidth="150.0" preserveRatio="true" layoutX="10" layoutY="20">
            <image>
                <Image url="@../../../../images/Logo_UADY.svg.png"/>
            </image>
        </ImageView>
        <ImageView fitHeight="200.0" fitWidth="200.0" preserveRatio="true" layoutX="225" layoutY="50">
            <image>
                <Image url="@../../../../images/login.jpg"/>
            </image>
        </ImageView>
        <Label text="SISTEMA DE VENTAS" underline="true" layoutX="150" layoutY="260" prefWidth="350" alignment="CENTER">
            <font><Font size="28.0"/></font>
        </Label>
        <Label text="IDENTIFICACIÓN" alignment="CENTER" layoutX="200" layoutY="310" prefWidth="250">
            <font><Font size="24.0"/></font>
        </Label>
        <TextField fx:id="user" prefWidth="250" layoutX="200" layoutY="350"/>
        <Label text="CONTRASEÑA" alignment="CENTER" layoutX="200" layoutY="400" prefWidth="250">
            <font><Font size="24.0"/></font>
        </Label>
        <PasswordField fx:id="password" prefWidth="250" layoutX="200" layoutY="440"/>
        <Button text="INICIAR SESIÓN" onAction="#signIn" layoutX="265" layoutY="500" prefWidth="120" prefHeight="35"/>
    </children>
</AnchorPane>

