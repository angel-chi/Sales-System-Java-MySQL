<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!-- StackPane: Contenedor principal que centra el contenido, fuente https://www.geeksforgeeks.org/java/javafx-stackpane-class/ -->
<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.MainController"
           prefHeight="600.0" prefWidth="450.0"> <!-- prefHeight y prefWidth definen el tamaño de la ventana -->

    <!-- VBox: Contenedor vertical que apila elementos uno debajo del otro -->
    <VBox alignment="CENTER" spacing="20"> <!-- spacing="20" pone 20 pixeles de separación entre cada elemento -->

        <!-- Padding: Márgenes internos (30 pixeles en todos los lados) -->
        <padding>
            <Insets top="30" bottom="30" left="175" right="175"/>
        </padding>

      <HBox alignment="CENTER" spacing="10"> <!-- preserveRatio mantiene la proporción original de la imagen -->
            <ImageView fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../../images/logosinfondo.png" /> <!-- logo sin fondo y con buena calidad, detalles mínimos pero lindos -->
                </image>
            </ImageView>
        </HBox>

        <HBox alignment="CENTER" spacing="10">

            <Label alignment="CENTER" text="Sistema de Ventas" underline="true">
                <font>
                    <Font size="28.0" />
                </font>
            </Label>
        </HBox>

        <VBox alignment="CENTER" spacing="10" prefWidth="250">

            <Label alignment="CENTER" text="Usuario" textAlignment="CENTER">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>

            <!-- TextField: Campo de texto donde el usuario escribe su nombre -->
            <TextField fx:id="user" prefWidth="200"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10" prefWidth="250">

            <Label alignment="CENTER" text="Contraseña">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>

            <!-- PasswordField: Campo de texto que oculta lo que se escribe para contraseñas -->
            <PasswordField fx:id="password" prefWidth="200"/>
        </VBox>

        <!-- Botón para iniciar sesión -->
        <Button mnemonicParsing="false" onAction="#signIn" prefHeight="33.0" prefWidth="119.0" text="INICIAR SESIÓN">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Button>

    </VBox>

</StackPane>