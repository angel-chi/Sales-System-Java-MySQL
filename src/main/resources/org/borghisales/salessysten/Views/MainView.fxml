<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.MainController">

    <children>

        <!-- Fondo -->
        <ImageView fitHeight="500.0" fitWidth="500.0" preserveRatio="false">
            <image>
                <Image url="@../../../../images/fondo2.jpg"/>
            </image>
        </ImageView>

        <!-- Logo Superior -->
        <ImageView fitHeight="100.0" fitWidth="100.0" preserveRatio="true">
            <image>
                <Image url="@../../../../images/logo1.jpeg"/>
            </image>
        </ImageView>
        <ImageView fitHeight="150.0" fitWidth="150.0" layoutX="185.0" layoutY="70.0" pickOnBounds="true" preserveRatio="true">

        <!-- Imagen adicional -->
            <image>
                <Image url="@../../../../images/user.jpeg"/>
            </image>
        </ImageView>

        <Label
                alignment="CENTER"
                layoutX="100.0" layoutY="22.0"
                prefHeight="45.0" prefWidth="300.0"
                text="SISTEMA DE VENTAS"
                underline="true">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <Label
                alignment="CENTER"
                blendMode="SRC_ATOP"
                layoutX="170.0" layoutY="220.0"
                prefHeight="45.0" prefWidth="170.0"
                text="USUARIO"
                textAlignment="CENTER"
                wrapText="true">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <Label
                alignment="CENTER"
                layoutX="160.0" layoutY="300.0"
                prefHeight="45.0" prefWidth="200.0"
                text="CONTRASEÑA">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <TextField
                fx:id="user"
                layoutX="180.0"
                layoutY="270.0"/>

        <PasswordField
                fx:id="password"
                layoutX="180.0"
                layoutY="350.0"/>


        <Button
                layoutX="200.0" layoutY="400.0"
                mnemonicParsing="false"
                onAction="#signIn"
                prefHeight="33.0" prefWidth="119.0"
                text="INICIAR SESION"/>


    </children>
</AnchorPane>
