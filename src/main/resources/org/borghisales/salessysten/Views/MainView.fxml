<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController">
    <children>

        <ImageView fitHeight="71.0" fitWidth="73.0" layoutX="500.0" layoutY="9.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/img.png" />
            </image>
        </ImageView>


        <Label alignment="CENTER" layoutX="150.0" layoutY="30.0"
               prefHeight="45.0" prefWidth="300.0"
               text="SISTEMA DE VENTAS" underline="true">
            <font>
                <Font size="28.0" />
            </font>
        </Label>

        <Label alignment="CENTER" layoutX="150.0" layoutY="100.0"
               prefHeight="30.0" prefWidth="300.0"
               text="ID VENDEDOR">
            <font>
                <Font size="20.0" />
            </font>
        </Label>


        <TextField fx:id="user" layoutX="150.0" layoutY="135.0"
                   prefHeight="30.0" prefWidth="300.0"
                   promptText="Ingrese su ID" />


        <Label alignment="CENTER" layoutX="150.0" layoutY="190.0"
               prefHeight="30.0" prefWidth="300.0"
               text="CONTRASEÑA">
            <font>
                <Font size="20.0" />
            </font>
        </Label>


        <PasswordField fx:id="password" layoutX="150.0" layoutY="225.0"
                       prefHeight="30.0" prefWidth="300.0"
                       promptText="Ingrese su contraseña" />


        <Button layoutX="240.0" layoutY="300.0"
                mnemonicParsing="false" onAction="#signIn"
                prefHeight="33.0" prefWidth="119.0"
                text="ENTRAR" />
    </children>
</AnchorPane>
