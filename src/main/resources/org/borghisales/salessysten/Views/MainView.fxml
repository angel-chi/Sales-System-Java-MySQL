<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController">

    <children>

        <!-- Logo arriba a la derecha, anclado, no fijo con layoutX/layoutY -->
        <ImageView fitHeight="71.0" fitWidth="73.0"
                   pickOnBounds="true" preserveRatio="true"
                   AnchorPane.topAnchor="10.0"
                   AnchorPane.rightAnchor="10.0">
            <image>
                <Image url="@../../../../images/img.png" />
            </image>
        </ImageView>

        <!-- Contenedor principal centrado y expandible -->
        <VBox alignment="CENTER" spacing="15.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- Título -->
            <Label text="SISTEMA DE VENTAS" underline="true">
                <font>
                    <Font size="28.0" />
                </font>
            </Label>

            <!-- Label ID -->
            <Label text="ID VENDEDOR">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>

            <!-- Campo de usuario -->
            <TextField fx:id="user"
                       prefHeight="30.0" prefWidth="300.0"
                       maxWidth="300.0"
                       promptText="Ingrese su ID" />

            <!-- Label contraseña -->
            <Label text="CONTRASEÑA">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>

            <!-- Campo de contraseña -->
            <PasswordField fx:id="password"
                           prefHeight="30.0" prefWidth="300.0"
                           maxWidth="300.0"
                           promptText="Ingrese su contraseña" />

            <!-- Botón Entrar -->
            <Button text="ENTRAR"
                    mnemonicParsing="false"
                    onAction="#signIn"
                    prefHeight="33.0" prefWidth="150.0" />
        </VBox>

    </children>
</AnchorPane>
