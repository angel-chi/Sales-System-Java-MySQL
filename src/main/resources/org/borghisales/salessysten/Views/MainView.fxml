<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController"
            prefWidth="450" prefHeight="520">

    <center>
        <VBox alignment="CENTER" spacing="25">
            <children>


                <ImageView fitHeight="90" fitWidth="90" preserveRatio="true">
                    <image>
                        <Image url="@../../../../images/img.png" />
                    </image>
                </ImageView>

                <Label text="SISTEMA DE VENTAS" underline="true">
                    <font>
                        <Font size="28"/>
                    </font>
                </Label>

                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT"/>
                        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>
                        <Label text="USUARIO" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <font><Font size="22"/></font>
                        </Label>
                        <TextField fx:id="user" prefWidth="200"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="CONTRASEÑA" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <font><Font size="22"/></font>
                        </Label>
                        <PasswordField fx:id="password" prefWidth="200"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <Button text="INICIAR SESION"
                        onAction="#signIn"
                        prefWidth="150" prefHeight="40"/>

            </children>
        </VBox>
    </center>

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

</BorderPane>