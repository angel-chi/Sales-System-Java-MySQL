<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.borghisales.salessysten.controllers.MainController">

    <VBox
            spacing="10"
            AnchorPane.leftAnchor="30"
            AnchorPane.rightAnchor="30"
            AnchorPane.topAnchor="30"
            AnchorPane.bottomAnchor="30"

            alignment="CENTER">

        <ImageView fx:id="logo" fitHeight="80" fitWidth="80" preserveRatio="true">
            <Image url="@../../../../images/img.png"/>
        </ImageView>

        <Label text="SISTEMA DE VENTAS">
            <font>
                <Font size="35"/>
            </font>
        </Label>

        <Label text="Ingresa ID" style="-fx-font-size: 18px;"/>

        <TextField fx:id="user" prefWidth="200" maxWidth="500"/>

        <Label text="Ingresa contraseña" style="-fx-font-size: 18px;"/>

        <PasswordField fx:id="password" prefWidth="200" maxWidth="500"/>

        <Button text="Iniciar sesión" onAction="#signIn" prefWidth="120"/>

    </VBox>

</AnchorPane>
