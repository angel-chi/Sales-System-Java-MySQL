<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.MainController">
   <top>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" onKeyPressed="#signIn" prefWidth="320.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="71.0" fitWidth="73.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../../images/img.png" />
               </image>
            </ImageView>
            <Label alignment="CENTER" prefHeight="45.0" prefWidth="200.0" text="SISTEMA DE" underline="true">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
             <Label alignment="CENTER" prefHeight="45.0" prefWidth="200.0" text="VENTAS" textAlignment="CENTER" underline="true">
                 <font>
                     <Font size="28.0" />
                 </font>
             </Label>
            <Label alignment="CENTER" blendMode="SRC_ATOP" prefHeight="45.0" prefWidth="150.0" text="DNI" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <TextField fx:id="user" maxWidth="220.0" minWidth="220.0" prefWidth="220.0" />
            <Label alignment="CENTER" prefHeight="45.0" prefWidth="200.0" text="CONTRASEÑA">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <PasswordField fx:id="password" maxWidth="220.0" minWidth="220.0" prefWidth="220.0" />
            <Button mnemonicParsing="false" onAction="#signIn" prefHeight="45.0" prefWidth="200.0" text="INGRESAR" />
         </children>
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <padding>
      <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
   </padding>
</BorderPane>
