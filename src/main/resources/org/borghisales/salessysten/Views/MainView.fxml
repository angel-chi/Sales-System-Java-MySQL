<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #2c2c2c, #1e1e1e);"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController">

    <children>
        <VBox alignment="CENTER" spacing="18.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- TÍTULO -->
            <Label text="SISTEMA DE VENTAS"
                   style="-fx-text-fill: #f2f2f2;
                   -fx-font-weight: bold;">
                <font>
                    <Font name="Segoe UI Semibold" size="34.0" />
                </font>
            </Label>
            <Separator prefWidth="300"
                       style="-fx-background-color: #555; -fx-opacity: 0.4;"/>

            <!-- Ícono -->
            <ImageView fitHeight="100.0" fitWidth="100.0"
                       pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../../images/usuarioInicio.png" />
                </image>
            </ImageView>

            <!-- ID -->
            <Label text="ID VENDEDOR"
                   style="-fx-text-fill: #dcdcdc;">
                <font>
                    <Font name="Segoe UI" size="18.0" />
                </font>
            </Label>

            <TextField fx:id="user"
                       prefHeight="35.0" prefWidth="300.0" maxWidth="300.0"
                       promptText="Ingrese su ID"
                       style="-fx-background-color: #333333;
                              -fx-text-fill: #ffffff;
                              -fx-prompt-text-fill: #999999;
                              -fx-background-radius: 6;" />

            <!-- CONTRASEÑA -->
            <Label text="CONTRASEÑA"
                   style="-fx-text-fill: #dcdcdc;">
                <font>
                    <Font name="Segoe UI" size="18.0" />
                </font>
            </Label>

            <PasswordField fx:id="password"
                           prefHeight="35.0" prefWidth="300.0" maxWidth="300.0"
                           promptText="Ingrese su contraseña"
                           style="-fx-background-color:#333333;
                                  -fx-text-fill:#ffffff;
                                  -fx-prompt-text-fill:#999999;
                                  -fx-background-radius:6;" />

            <!-- BOTÓN -->
            <Button text="INGRESAR"
                    mnemonicParsing="false"
                    onAction="#signIn"
                    prefHeight="35.0" prefWidth="160.0"
                    style="-fx-background-color: #3a3a3a;
                           -fx-text-fill: #ffffff;
                           -fx-background-radius: 8;
                           -fx-border-color: #555555;
                           -fx-border-radius: 8;">
                <font>
                    <Font name="Segoe UI Semibold" size="16.0" />
                </font>
            </Button>

        </VBox>

    </children>
</AnchorPane>
