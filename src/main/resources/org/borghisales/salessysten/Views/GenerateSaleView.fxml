<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane prefHeight="700.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.GenerateSaleController">
    <AnchorPane prefHeight="700.0" prefWidth="800.0">
        <Label layoutX="216.0" layoutY="11.0" prefHeight="39.0" prefWidth="400.0" text="PUNTO DE VENTA &quot;BORGHI SYSTEM&quot;" underline="true">
            <font>
                <Font name="System Bold" size="17.0" />
            </font>
        </Label>
        <ImageView fitHeight="111.0" fitWidth="117.0" layoutX="50.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../../../../images/img_1.png" />
        </ImageView>
        <Separator layoutX="6.0" layoutY="135.0" prefHeight="16.0" prefWidth="790.0" />
        <Label layoutX="234.0" layoutY="43.0" prefHeight="21.0" prefWidth="350.0" text="VENTA DE PRODUCTOS TECNOLÓGICOS">
            <font>
                <Font size="15.0" />
            </font>
        </Label>
        <Label layoutX="300.0" layoutY="66.0" prefHeight="17.0" prefWidth="120.0" text="TEL: 8383-03939" />
        <Label layoutX="218.0" layoutY="104.0" prefHeight="17.0" prefWidth="150.0" text="NUMERO SERIAL:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <TextField fx:id="serial" editable="false" layoutX="336.0" layoutY="101.0" prefHeight="16.0" prefWidth="150.0" />


        <Label layoutX="21.0" layoutY="166.0" text="INE CLIENTE:" wrapText="true" />
        <TextField fx:id="codCustomer" layoutX="125.0" layoutY="166.0" prefHeight="25.0" prefWidth="150.0" />
        <Button layoutX="250.0" layoutY="166.0" mnemonicParsing="false" onAction="#openCustomerManagement" prefHeight="25.0" prefWidth="160.0" text="GESTIONAR CLIENTE" />
        <TextField fx:id="customerName" editable="false" layoutX="496.0" layoutY="166.0" prefHeight="25.0" prefWidth="180.0" />
        <Label layoutX="420.0" layoutY="170.0" text="CLIENTE:" wrapText="true" />

        <Label layoutX="21.0" layoutY="204.0" text="COD PROD:" wrapText="true" />
        <TextField fx:id="codProduct" layoutX="124.0" layoutY="200.0" prefHeight="25.0" prefWidth="150.0" />
        <Button layoutX="250.0" layoutY="200.0" mnemonicParsing="false" onAction="#openProductManagement" prefHeight="25.0" prefWidth="160.0" text="GESTIONAR PRODUCTO" />
        <TextField fx:id="productName" editable="false" layoutX="496.0" layoutY="199.0" prefHeight="25.0" prefWidth="180.0" />
        <Label layoutX="420.0" layoutY="204.0" text="PRODUCTO:" wrapText="true" />

        <Label layoutX="22.0" layoutY="238.0" text="PRECIO:" wrapText="true" />
        <TextField fx:id="price" layoutX="125.0" layoutY="234.0" prefHeight="25.0" prefWidth="150.0" />
        <Label layoutX="420.0" layoutY="238.0" text="DISPONIB:" wrapText="true" />
        <TextField fx:id="stock" editable="false" layoutX="496.0" layoutY="234.0" prefHeight="25.0" prefWidth="180.0" />

        <Label layoutX="22.0" layoutY="274.0" text="CANTIDAD:" wrapText="true" />
        <Spinner fx:id="quantity" layoutX="125.0" layoutY="269.0" prefHeight="25.0" prefWidth="150.0" />
        <Label layoutX="420.0" layoutY="273.0" text="VENDEDOR:" wrapText="true" />
        <TextField fx:id="seller" editable="false" layoutX="496.0" layoutY="269.0" prefHeight="25.0" prefWidth="180.0" />


        <Label layoutX="590.0" layoutY="104.0" text="FECHA:" wrapText="true" />
        <TextField fx:id="date" editable="false" layoutX="650.0" layoutY="99.0" prefHeight="25.0" prefWidth="120.0" />

        <Button layoutX="12.0" layoutY="300.0" mnemonicParsing="false" onAction="#addShoppingCart" prefHeight="40.0" prefWidth="150.0" text="AÑADIR PRODUCTO"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" />
        <Separator layoutX="-2.0" layoutY="338.0" prefHeight="16.0" prefWidth="790.0" />

        <TableView fx:id="tableSale" layoutX="12.0" layoutY="345.0" prefHeight="250.0" prefWidth="768.0">
            <columns>
                <TableColumn fx:id="colNro" prefWidth="91.0" sortable="false" style="-fx-alignment: CENTER;" text="NR" />
                <TableColumn fx:id="colCod" prefWidth="112.0" sortable="false" style="-fx-alignment: CENTER;" text="CODIGO" />
                <TableColumn fx:id="colProduct" prefWidth="170.0" sortable="false" style="-fx-alignment: CENTER;" text="PRODUCTO" />
                <TableColumn fx:id="colQuantity" prefWidth="110.0" style="-fx-alignment: CENTER;" text="CANTIDAD" />
                <TableColumn fx:id="colPrice" prefWidth="134.0" style="-fx-alignment: CENTER;" text="PRECIO UNIT." />
                <TableColumn fx:id="colTotal" prefWidth="129.0" style="-fx-alignment: CENTER;" text="TOTAL" />
            </columns>
        </TableView>

        <Separator layoutX="-4.0" layoutY="600.0" prefHeight="2.0" prefWidth="790.0" />

        <Button layoutX="53.0" layoutY="610.0" mnemonicParsing="false" onAction="#cancel" prefHeight="25.0" prefWidth="102.0" text="CANCELAR" />
        <Button layoutX="192.0" layoutY="610.0" mnemonicParsing="false" onAction="#generateSale" text="GENERAR VENTA" />
        <TextField fx:id="total" editable="false" layoutX="600.0" layoutY="610.0" prefWidth="120.0" />
        <Label layoutX="383.0" layoutY="615.0" text="VENTA TOTAL:" wrapText="true" />
    </AnchorPane>
</AnchorPane>
