<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="950.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.GenerateSaleController">

    <top>
        <VBox style="-fx-background-color: #252526; -fx-padding: 15 20 15 20; -fx-border-color: #333; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Button fx:id="btnReturn" text="← VOLVER" onAction="#returnToMenu"
                        style="-fx-background-color: transparent; -fx-text-fill: #ffa726; -fx-border-color: #fb8c00; -fx-border-radius: 5;" />

                <Label text="PUNTO DE VENTA" textFill="WHITE">
                    <font><Font name="Segoe UI Semibold" size="22.0"/></font>
                    <effect><DropShadow color="#0000004d"/></effect>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="VENDEDOR" textFill="#888"><font><Font size="10"/></font></Label>
                        <Label fx:id="lblSeller" text="Usuario" textFill="#ddd"><font><Font name="Segoe UI Bold" size="12"/></font></Label>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="FECHA" textFill="#888"><font><Font size="10"/></font></Label>
                        <Label fx:id="lblDate" text="2024-10-27" textFill="#ddd"><font><Font name="Segoe UI Bold" size="12"/></font></Label>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="SERIE VENTA" textFill="#888"><font><Font size="10"/></font></Label>
                        <Label fx:id="lblSerial" text="0000" textFill="#4caf50"><font><Font name="Monospaced Bold" size="16"/></font></Label>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" style="-fx-background: #1e1e1e; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #2b2b2b; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 0);" prefWidth="320">

                <VBox spacing="10">
                    <Label text="DATOS DEL CLIENTE" textFill="#a5d6a7"><font><Font name="Segoe UI Bold" size="12"/></font></Label>
                    <HBox spacing="10">
                        <TextField fx:id="codCustomer" promptText="ID Cliente" prefHeight="30" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"/>
                        <Button fx:id="btnSearchCust" text="🔍" onAction="#searchCustomer" prefHeight="30" prefWidth="40"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    </HBox>
                    <TextField fx:id="customerName" promptText="Nombre del Cliente" editable="false" prefHeight="30"
                               style="-fx-background-color: #3a3a3a; -fx-text-fill: #ccc; -fx-background-radius: 5;"/>
                </VBox>

                <Separator style="-fx-opacity: 0.1;"/>

                <VBox spacing="10">
                    <Label text="AGREGAR PRODUCTO" textFill="#90caf9"><font><Font name="Segoe UI Bold" size="12"/></font></Label>
                    <HBox spacing="10">
                        <TextField fx:id="codProduct" promptText="ID Producto" prefHeight="30" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"/>
                        <Button fx:id="btnSearchProd" text="🔍" onAction="#searchProduct" prefHeight="30" prefWidth="40"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    </HBox>
                    <TextField fx:id="productName" promptText="Descripción" editable="false" prefHeight="30"
                               style="-fx-background-color: #3a3a3a; -fx-text-fill: #ccc; -fx-background-radius: 5;"/>

                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0">
                            <Label text="Stock" textFill="#888" style="-fx-font-size: 10px;"/>
                            <TextField fx:id="stock" editable="false" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ccc;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1">
                            <Label text="Precio" textFill="#888" style="-fx-font-size: 10px;"/>
                            <TextField fx:id="price" editable="false" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ccc;"/>
                        </VBox>
                    </GridPane>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Cantidad:" textFill="#ddd"/>
                        <Spinner fx:id="quantity" prefHeight="30" editable="true" styleClass="split-arrows-horizontal"/>
                    </HBox>

                    <Button fx:id="btnAdd" text="AÑADIR AL CARRITO" onAction="#addShoppingCart" maxWidth="Infinity" prefHeight="35"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>

                <Separator style="-fx-opacity: 0.1;"/>

                <VBox spacing="10">
                    <Label text="MÉTODO DE PAGO" textFill="#ffcc80"><font><Font name="Segoe UI Bold" size="12"/></font></Label>
                    <ComboBox fx:id="paymentMethod" maxWidth="Infinity" prefHeight="30"
                              style="-fx-background-color: #333; -fx-mark-color: white; -fx-text-base-color: white;"/>

                    <VBox fx:id="cardDetailsContainer" spacing="5">
                        <Label text="Últimos 4 dígitos:" textFill="#ddd"/>
                        <TextField fx:id="cardLast4" promptText="XXXX" prefHeight="30"
                                   style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </left>

    <center>
        <VBox style="-fx-padding: 20;">
            <TableView fx:id="tableSale" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #2b2b2b; -fx-base: #2b2b2b; -fx-control-inner-background: #2b2b2b; -fx-table-cell-border-color: transparent;">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNro" text="#" maxWidth="40" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCod" text="CÓDIGO" maxWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colProduct" text="PRODUCTO" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colQuantity" text="CANT." maxWidth="60" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colPrice" text="PRECIO U." maxWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colTotal" text="TOTAL" maxWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                </columns>
                <placeholder>
                    <Label text="Agregue productos para iniciar la venta" textFill="#666"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-background-color: #252526; -fx-padding: 20; -fx-border-color: #333; -fx-border-width: 1 0 0 0;">

            <Button fx:id="btnCancel" text="CANCELAR VENTA" onAction="#cancel" prefHeight="45" prefWidth="150"
                    style="-fx-background-color: #424242; -fx-text-fill: #aaa; -fx-background-radius: 5;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="TOTAL A PAGAR:" textFill="#ccc">
                <font><Font name="Segoe UI" size="18"/></font>
            </Label>

            <TextField fx:id="total" editable="false" text="0.00" alignment="CENTER_RIGHT" prefWidth="150" prefHeight="45"
                       style="-fx-background-color: #333; -fx-text-fill: #4caf50; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button fx:id="btnPay" text="COBRAR" onAction="#generateSale" prefHeight="45" prefWidth="150"
                    style="-fx-background-color: #e65100; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5;"/>
        </HBox>
    </bottom>

</BorderPane>