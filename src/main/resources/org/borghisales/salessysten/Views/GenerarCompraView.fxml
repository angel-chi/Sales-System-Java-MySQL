<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!-- StackPane principal -->
<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.GenerarCompraController"
           prefHeight="700.0" prefWidth="900.0">

    <!-- VBox principal -->
    <VBox alignment="TOP_CENTER" spacing="10">
        <padding>
            <Insets top="20" bottom="20" left="30" right="30"/>
        </padding>

        <HBox alignment="CENTER" spacing="20">
            <ImageView fitHeight="111.0" fitWidth="117.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../../images/compra.png" />
                </image>
            </ImageView>

            <!-- Títulos -->
            <VBox alignment="CENTER_LEFT">
                <Label text="SISTEMA DE COMPRAS &quot;DZIB-TENORIO&quot;" underline="true">
                    <font>
                        <Font name="System Bold" size="17.0" />
                    </font>
                </Label>
                <Label text="GESTIÓN DE COMPRAS DE PRODUCTOS">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
                <Label text="TEL: 9999-989796" />
            </VBox>
        </HBox>

        <Separator prefWidth="800.0" />

        <!-- Formulario de entrada -->
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>

            <!-- Fila 1: ID Proveedor -->
            <Label text="ID Proveedor:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="idProveedor" prefWidth="117.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="BUSCAR" onAction="#searchProveedor" prefWidth="80.0" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="Proveedor:" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <TextField fx:id="nombreProveedor" editable="false" prefWidth="148.0" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

            <!-- Fila 2: ID Producto -->
            <Label text="ID Producto:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="idProducto" prefWidth="117.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Button text="BUSCAR" onAction="#searchProduct" prefWidth="80.0" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Label text="Producto:" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            <TextField fx:id="nombreProducto" editable="false" prefWidth="148.0" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

            <!-- Fila 3: Precio de Compra -->
            <Label text="Precio Compra:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="precioCompra" prefWidth="117.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button text="AGREGAR" onAction="#addShoppingCart" prefWidth="80.0" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Label text="Stock Actual:" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <TextField fx:id="stockActual" editable="false" prefWidth="148.0" GridPane.columnIndex="4" GridPane.rowIndex="2"/>

            <!-- Fila 4: Cantidad -->
            <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Spinner fx:id="cantidad" prefWidth="117.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="Vendedor:" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            <TextField fx:id="vendedor" editable="false" prefWidth="148.0" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
        </GridPane>

        <Separator prefWidth="800.0" />

        <!-- Tabla de productos -->
        <TableView fx:id="tableCompra" prefHeight="250.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="colIdProducto" prefWidth="160.0" sortable="false" style="-fx-alignment: CENTER;" text="ID PRODUCTO" />
                <TableColumn fx:id="colIdProveedor" prefWidth="160.0" sortable="false" style="-fx-alignment: CENTER;" text="ID PROVEEDOR" />
                <TableColumn fx:id="colCantidad" prefWidth="160.0" style="-fx-alignment: CENTER;" text="CANTIDAD" />
                <TableColumn fx:id="colPrecio" prefWidth="160.0" style="-fx-alignment: CENTER;" text="PRECIO COMPRA" />
                <TableColumn fx:id="colSubtotal" prefWidth="158.0" style="-fx-alignment: CENTER;" text="SUBTOTAL" />
            </columns>
        </TableView>

        <Separator prefWidth="800.0" />

        <!-- Botones inferiores y total -->
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="10"/>
            </padding>

            <Button text="CANCELAR" onAction="#cancel" prefWidth="120.0" prefHeight="25.0"/>
            <Button text="GENERAR COMPRA" onAction="#generarCompra" prefWidth="150.0" prefHeight="25.0"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Total"/>
            <TextField fx:id="total" editable="false" prefWidth="100.0"/>
        </HBox>

    </VBox>

</StackPane>