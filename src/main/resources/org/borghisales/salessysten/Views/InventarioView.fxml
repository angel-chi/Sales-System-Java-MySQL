<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!-- StackPane principal -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.InventarioController" prefHeight="750.0" prefWidth="1000.0">

    <!-- VBox principal -->
    <VBox alignment="TOP_CENTER" spacing="20">
        <padding>
            <Insets top="30" bottom="30" left="40" right="40"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER" spacing="20">
            <VBox alignment="CENTER">
                <Label text="INVENTARIO DE PRODUCTOS" underline="true">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>
                <Label text="Vista de consulta - Solo lectura">
                </Label>
            </VBox>
        </HBox>

        <!-- Filtros de búsqueda -->
        <HBox spacing="15" alignment="CENTER">
            <Label text="Buscar:">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
            <TextField fx:id="searchField" promptText="Nombre del producto..." prefWidth="300.0"/>
            <Button text="BUSCAR" onAction="#searchProduct" prefWidth="100.0" prefHeight="30.0"/>
            <Button text="MOSTRAR TODO" onAction="#showAll" prefWidth="120.0" prefHeight="30.0"/>
        </HBox>

        <!-- Estadísticas rápidas -->
        <HBox spacing="30" alignment="CENTER">
            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #e3f2fd; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="Total Productos">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="totalProductos" text="0">
                    <font>
                        <Font size="24.0" name="System Bold"/>
                    </font>
                </Label>
            </VBox>

            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #c8e6c9; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="Productos Activos">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="productosActivos" text="0">
                    <font>
                        <Font size="24.0" name="System Bold"/>
                    </font>
                </Label>
            </VBox>

            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #ffecb3; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="Stock Bajo">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="stockBajo" text="0">
                    <font>
                        <Font size="24.0" name="System Bold"/>
                    </font>
                </Label>
            </VBox>

            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #ffcdd2; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="Sin Stock">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="sinStock" text="0">
                    <font>
                        <Font size="24.0" name="System Bold"/>
                    </font>
                </Label>
            </VBox>
        </HBox>

        <Separator prefWidth="900.0"/>

        <!-- Tabla de inventario -->
        <TableView fx:id="tableInventario" prefHeight="350.0" prefWidth="900.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre del Producto"/>
                <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAlerta" prefWidth="208.0" text="Alerta" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>

        <!-- Botón salir -->
        <HBox alignment="CENTER" spacing="15">
            <Button text="SALIR" onAction="#exit" prefWidth="150.0" prefHeight="40.0">
                <font>
                    <Font size="16.0"/>
                </font>
            </Button>
        </HBox>

    </VBox>

</StackPane>