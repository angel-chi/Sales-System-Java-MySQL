<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.PasswordField?>
<AnchorPane prefHeight="474.0" prefWidth="653.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.SellerController">
    <children>
        <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addSeller" prefHeight="32.0" prefWidth="101.0" text="AÑADIR" />
        <TableView fx:id="tableSellers" layoutX="26.0" layoutY="228.0" prefHeight="221.0" prefWidth="602.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="120.0" text="ID" />
                <TableColumn fx:id="colDni" prefWidth="111.0" text="Usuario" />
                <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre" />
                <TableColumn fx:id="colPhone" prefWidth="124.0" text="Tel." />
                <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
            </columns>
        </TableView>
        <Label layoutX="25.0" layoutY="62.0" prefHeight="17.0"  text="ID:" underline="true">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="88.0" prefHeight="17.0" text="NOMBRE:" underline="true">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="114.0" prefHeight="26.0" text="TELÉFONO:" underline="true">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="145.0" prefHeight="17.0"  text="CONTRASEÑA:" underline="true">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <TextField fx:id="dni" layoutX="140.0" layoutY="55.0" prefHeight="25.0" prefWidth="289.0" />
        <TextField fx:id="name" layoutX="140.0" layoutY="84.0" prefHeight="25.0" prefWidth="289.0" />
        <TextField fx:id="phone" layoutX="140.0" layoutY="114.0" prefHeight="25.0" prefWidth="289.0" />
        <PasswordField fx:id="user" layoutX="140.0" layoutY="144.0" prefHeight="25.0" prefWidth="289.0" />
        <Button layoutX="458.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateSeller" prefHeight="32.0" prefWidth="101.0" text="ACTUALIZAR" />
        <Button layoutX="458.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteSeller" prefHeight="32.0" prefWidth="101.0" text="ELIMINAR" />
        <Button layoutX="458.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="101.0" text="VACIAR" />
        <ComboBox fx:id="cbState" layoutX="140.0" layoutY="176.0" prefHeight="25.0" prefWidth="283.0" />
        <Label layoutX="51.0" layoutY="173.0" prefHeight="17.0" prefWidth="54.0" text="STATE:" underline="true">
            <font>
                <Font size="17.0" />
            </font>
        </Label>
        <Label alignment="CENTER" layoutX="110.0" layoutY="10.0" prefHeight="17.0" prefWidth="400.0" text="ADMINISTRACIÓN DE VENDEDORES" underline="true">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
