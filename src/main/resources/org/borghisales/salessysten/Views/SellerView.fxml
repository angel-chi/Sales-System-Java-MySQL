<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="700.0" stylesheets="@CSS/MainView.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.SellerController">
   <children>
      <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addSeller" prefHeight="54.0" prefWidth="232.0" style="-fx-background-color: #43d051; -fx-text-fill: #fff;" text="AGREGAR" />
      <TableView fx:id="tableSellers" layoutX="5.0" layoutY="312.0" prefHeight="325.0" prefWidth="688.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="120.0" text="Identificador" />
          <TableColumn fx:id="colDni" prefWidth="111.0" text="Usuario" />
            <TableColumn fx:id="colName" prefWidth="124.0" text="Nombre" />
            <TableColumn fx:id="colPhone" prefWidth="124.0" text="Teléfono" />
            <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
        </columns>
      </TableView>
      <Label layoutX="4.0" layoutY="62.0" prefHeight="21.0" prefWidth="90.0" text="USUARIO:" underline="true">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label layoutX="4.0" layoutY="107.0" prefHeight="21.0" prefWidth="90.0" text="NOMBRE:" underline="true">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label layoutX="8.0" layoutY="154.0" prefHeight="26.0" prefWidth="100.0" text="TELEFONO:" underline="true">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label layoutX="4.0" layoutY="199.0" prefHeight="21.0" prefWidth="130.0" text="CONTRASENA:" underline="true">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <TextField fx:id="dni" layoutX="128.0" layoutY="52.0" prefHeight="38.0" prefWidth="283.0">
         <font>
            <Font size="16.0" />
         </font></TextField>
      <TextField fx:id="name" layoutX="128.0" layoutY="101.0" prefHeight="38.0" prefWidth="283.0">
         <font>
            <Font size="17.0" />
         </font></TextField>
      <TextField fx:id="phone" layoutX="128.0" layoutY="148.0" prefHeight="38.0" prefWidth="283.0">
         <font>
            <Font size="17.0" />
         </font></TextField>
      <TextField fx:id="user" layoutX="128.0" layoutY="193.0" prefHeight="38.0" prefWidth="283.0">
