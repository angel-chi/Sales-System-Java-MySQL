<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.SellerController">
    <children>
        <Button layoutX="500" layoutY="76" text="AÑADIR" prefWidth="110" onAction="#addSeller"/>
        <Button layoutX="500" layoutY="116" text="ACTUALIZAR" prefWidth="110" onAction="#updateSeller"/>
        <Button layoutX="500" layoutY="156" text="BORRAR" prefWidth="110" onAction="#deleteSeller"/>
        <Button layoutX="500" layoutY="196" text="LIMPIAR" prefWidth="110" onAction="#cleanCellsScreen"/>
        <TableView fx:id="tableSellers" layoutX="25" layoutY="300" prefWidth="600" prefHeight="300">
            <columns>
                <TableColumn fx:id="colId" prefWidth="120" text="IDVENTA"/>
                <TableColumn fx:id="colDni" prefWidth="120" text="IDENTIFICACIÓN"/>
                <TableColumn fx:id="colName" prefWidth="120" text="NOMBRE"/>
                <TableColumn fx:id="colPhone" prefWidth="120" text="TELÉFONO"/>
                <TableColumn fx:id="colState" prefWidth="120" text="ESTADO"/>
            </columns>
        </TableView>
        <Label layoutX="175" layoutY="20" text="GESTIÓN VENDEDOR" underline="true">
            <font>
                <Font size="22"/>
            </font>
        </Label>
        <Label layoutX="40" layoutY="80" text="IDENTIFICACIÓN:" underline="true">
            <font><Font size="16"/></font>
        </Label>
        <TextField fx:id="dni" layoutX="180" layoutY="76" prefWidth="300"/>
        <Label layoutX="40" layoutY="120" text="NOMBRE:" underline="true">
            <font><Font size="16"/></font>
        </Label>
        <TextField fx:id="name" layoutX="180" layoutY="116" prefWidth="300"/>
        <Label layoutX="40" layoutY="160" text="TELÉFONO:" underline="true">
            <font><Font size="16"/></font>
        </Label>
        <TextField fx:id="phone" layoutX="180" layoutY="156" prefWidth="300"/>
        <Label layoutX="40" layoutY="200" text="USUARIO:" underline="true">
            <font><Font size="16"/></font>
        </Label>
        <TextField fx:id="user" layoutX="180" layoutY="196" prefWidth="300"/>
        <Label layoutX="40" layoutY="240" text="ESTADO:" underline="true">
            <font><Font size="16"/></font>
        </Label>
        <ComboBox fx:id="cbState" layoutX="180" layoutY="236" prefWidth="300"/>
    </children>
</AnchorPane>
