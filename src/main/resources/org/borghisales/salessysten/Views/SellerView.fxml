<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Group?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.SellerController"
           prefWidth="720.0" prefHeight="480.0"
           alignment="CENTER">

    <children>

        <Group>
            <children>

                <AnchorPane fx:id="rootPane"
                            prefHeight="480.0" prefWidth="720.0">


                    <Label alignment="CENTER"
                           layoutX="160.0" layoutY="10.0"
                           prefHeight="30.0" prefWidth="400.0"
                           text="GESTIÓN DE VENDEDORES"
                           underline="true"
                           wrapText="true">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>


                    <Label layoutX="40.0" layoutY="60.0"
                           prefHeight="40.0" prefWidth="210.0"
                           text="N°. IDENTIFICACIÓN:"
                           underline="true"
                           wrapText="true">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>

                    <Label layoutX="40.0" layoutY="90.0"
                           prefHeight="22.0" prefWidth="120.0"
                           text="NOMBRE:"
                           underline="true">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>

                    <Label layoutX="40.0" layoutY="116.0"
                           prefHeight="40.0" prefWidth="210.0"
                           text="NÚM. TELEFÓNICO:"
                           underline="true"
                           wrapText="true">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>

                    <Label layoutX="40.0" layoutY="148.0"
                           prefHeight="22.0" prefWidth="120.0"
                           text="USUARIO:"
                           underline="true">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>

                    <Label layoutX="40.0" layoutY="178.0"
                           prefHeight="22.0" prefWidth="120.0"
                           text="ESTADO:"
                           underline="true">
                        <font>
                            <Font size="17.0" />
                        </font>
                    </Label>


                    <TextField fx:id="dni"
                               layoutX="270.0" layoutY="60.0"
                               prefHeight="25.0" prefWidth="280.0" />

                    <TextField fx:id="name"
                               layoutX="270.0" layoutY="90.0"
                               prefHeight="25.0" prefWidth="280.0" />

                    <TextField fx:id="phone"
                               layoutX="270.0" layoutY="120.0"
                               prefHeight="25.0" prefWidth="280.0" />

                    <TextField fx:id="user"
                               layoutX="270.0" layoutY="150.0"
                               prefHeight="25.0" prefWidth="280.0" />

                    <ComboBox fx:id="cbState"
                              layoutX="270.0" layoutY="180.0"
                              prefHeight="25.0" prefWidth="280.0" />


                    <Button layoutX="570.0" layoutY="52.0"
                            mnemonicParsing="false"
                            onAction="#addSeller"
                            prefHeight="32.0" prefWidth="130.0"
                            text="AÑADIR" />

                    <Button layoutX="570.0" layoutY="90.0"
                            mnemonicParsing="false"
                            onAction="#updateSeller"
                            prefHeight="32.0" prefWidth="130.0"
                            text="ACTUALIZAR" />

                    <Button layoutX="570.0" layoutY="127.0"
                            mnemonicParsing="false"
                            onAction="#deleteSeller"
                            prefHeight="32.0" prefWidth="130.0"
                            text="ELIMINAR" />

                    <Button layoutX="570.0" layoutY="166.0"
                            mnemonicParsing="false"
                            onAction="#cleanCellsScreen"
                            prefHeight="32.0" prefWidth="130.0"
                            text="LIMPIAR CELDAS" />


                    <TableView fx:id="tableSellers"
                               layoutX="30.0" layoutY="230.0"
                               prefHeight="230.0" prefWidth="660.0">
                        <columns>
                            <TableColumn fx:id="colId"
                                         prefWidth="110.0"
                                         text="ID VENDEDOR" />
                            <TableColumn fx:id="colDni"
                                         prefWidth="150.0"
                                         text="N°. IDENTIFICACIÓN" />
                            <TableColumn fx:id="colName"
                                         prefWidth="130.0"
                                         text="NOMBRE" />
                            <TableColumn fx:id="colPhone"
                                         prefWidth="150.0"
                                         text="NÚM. TELEFÓNICO" />
                            <TableColumn fx:id="colState"
                                         prefWidth="120.0"
                                         text="ESTADO" />
                        </columns>
                    </TableView>

                </AnchorPane>

            </children>
        </Group>
    </children>
</StackPane>
