<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="rootPane"
            prefHeight="500.0" prefWidth="750.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.SellerController">

    <top>
        <VBox style="-fx-padding: 15 20 15 20; -fx-background-color: #252526; -fx-border-color: #333; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Button fx:id="btnReturn" text="← VOLVER" onAction="#returnToMenu"
                        style="-fx-background-color: transparent; -fx-text-fill: #ffa726; -fx-border-color: #fb8c00; -fx-border-radius: 5; -fx-cursor: hand;" />

                <Label text="GESTIÓN DE VENDEDORES" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Semibold" size="22.0" />
                    </font>
                    <effect>
                        <DropShadow color="#0000004d" height="5.0" radius="2.0" width="5.0" />
                    </effect>
                </Label>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <HBox spacing="30" alignment="CENTER_LEFT">

                <GridPane hgap="15" vgap="15" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="N° IDENTIFICACIÓN:" textFill="#dcdcdc" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="dni" promptText="8 dígitos"
                               style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                               prefHeight="30" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="NOMBRE:" textFill="#dcdcdc" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="name" promptText="Nombre de vendedor"
                               style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                               prefHeight="30" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="NÚM. TELEFÓNICO:" textFill="#dcdcdc" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="phone" promptText="10 dígitos"
                               style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                               prefHeight="30" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Contraseña:" textFill="#dcdcdc" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="user" promptText="Contraseña del Vendedor"
                               style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                               prefHeight="30" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="ESTADO:" textFill="#dcdcdc" GridPane.rowIndex="4" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="12"/></font>
                    </Label>
                    <ComboBox fx:id="cbState" prefHeight="30" maxWidth="Infinity"
                              style="-fx-background-color: #333; -fx-mark-color: white; -fx-text-base-color: white;"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="10" minWidth="140" alignment="TOP_CENTER">
                    <Button fx:id="btnAdd" text="AÑADIR" onAction="#addSeller" maxWidth="Infinity" prefHeight="35"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

                    <Button fx:id="btnUpdate" text="ACTUALIZAR" onAction="#updateSeller" maxWidth="Infinity" prefHeight="35"
                            style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

                    <Button fx:id="btnDelete" text="ELIMINAR" onAction="#deleteSeller" maxWidth="Infinity" prefHeight="35"
                            style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

                    <Button fx:id="btnClear" text="LIMPIAR" onAction="#cleanCellsScreen" maxWidth="Infinity" prefHeight="35"
                            style="-fx-background-color: #424242; -fx-text-fill: #aaa; -fx-background-radius: 5;"/>
                </VBox>
            </HBox>

            <TableView fx:id="tableSellers" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #2b2b2b; -fx-base: #2b2b2b; -fx-control-inner-background: #2b2b2b; -fx-table-cell-border-color: transparent;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" maxWidth="50" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDni" text="DNI" maxWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colName" text="NOMBRE" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colPhone" text="TELÉFONO" maxWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colState" text="ESTADO" maxWidth="100" style="-fx-alignment: CENTER;"/>
                </columns>
                <placeholder>
                    <Label text="No hay vendedores registrados" textFill="#666"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>
