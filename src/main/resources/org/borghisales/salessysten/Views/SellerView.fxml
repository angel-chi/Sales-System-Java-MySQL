      <Button layoutX="458.0" layoutY="113.0" mnemonicParsing="false" onAction="#updateSeller" prefHeight="54.0" prefWidth="232.0" style="-fx-background-color: #439dd0; -fx-text-fill: #fff;" text="ACTUALIZAR" />
      <Button layoutX="458.0" layoutY="176.0" mnemonicParsing="false" onAction="#deleteSeller" prefHeight="54.0" prefWidth="232.0" style="-fx-background-color: #d04343; -fx-text-fill: #fff;" text="ELIMINAR" />
      <Button layoutX="458.0" layoutY="239.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="54.0" prefWidth="232.0" style="-fx-background-color: #4b4b4b; -fx-text-fill: #fff;" text="LIMPIAR" />
