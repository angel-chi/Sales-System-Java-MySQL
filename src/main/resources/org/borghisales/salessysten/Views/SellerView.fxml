<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<GridPane alignment="CENTER"
          maxHeight="1.7976931348623157E308"
          maxWidth="1.7976931348623157E308"
          minHeight="-Infinity"
          minWidth="-Infinity"
          prefHeight="613.0"
          prefWidth="800.0"
          style="-fx-background-color: #EEEEEE;"
          xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.borghisales.salessysten.controllers.SellerController">

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="21.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="700.0" />
        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="21.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="31.0" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="1.7976931348623157E308" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="31.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <children>
        <Pane maxHeight="1.7976931348623157E308"
              maxWidth="1.7976931348623157E308"
              prefHeight="550.0"
              prefWidth="720.0"
              style="-fx-border-color: #6C4A95; -fx-border-width: 5; -fx-border-radius: 6; -fx-background-color: white;"
              GridPane.columnIndex="1"
              GridPane.rowIndex="1">
            <children>
                <VBox alignment="TOP_CENTER"
                      maxHeight="-Infinity"
                      maxWidth="-Infinity"
                      minHeight="-Infinity"
                      minWidth="-Infinity"
                      prefHeight="551.0"
                      prefWidth="700.0"
                      spacing="10.0">
                    <children>
                        <Pane>
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                        </Pane>
                        <Label alignment="CENTER"
                               contentDisplay="TOP"
                               style="-fx-font-weight: bold;"
                               text="Gestion de Vendedores"
                               textFill="#191919">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Label>
                        <Pane>
                            <padding>
                                <Insets top="20.0" />
                            </padding>
                        </Pane>

                        <GridPane styleClass="login-container" stylesheets="@style.css">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="300.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="140.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="-Infinity" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <VBox.margin>
                                <Insets bottom="15.0" left="35.0" right="35.0" top="10.0" />
                            </VBox.margin>
                            <children>

                                <Label text="INE:" underline="true"
                                       GridPane.rowIndex="0" GridPane.columnIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="dni"
                                           promptText="Ingrese el INE"
                                           styleClass="minimalistic-field"
                                           stylesheets="@style.css"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                <Button text="Agregar"
                                        mnemonicParsing="false"
                                        onAction="#addSeller"
                                        styleClass="minimalistic-button"
                                        stylesheets="@style.css"
                                        GridPane.rowIndex="0" GridPane.columnIndex="2" />

                                <Label text="NOMBRE:" underline="true"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="name"
                                           promptText="Ingrese el nombre"
                                           styleClass="minimalistic-field"
                                           stylesheets="@style.css"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                <Button text="Actualizar"
                                        mnemonicParsing="false"
                                        onAction="#updateSeller"
                                        styleClass="minimalistic-button"
                                        stylesheets="@style.css"
                                        GridPane.rowIndex="1" GridPane.columnIndex="2" />

                                <Label text="TELEFONO:" underline="true"
                                       GridPane.rowIndex="2" GridPane.columnIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="phone"
                                           promptText="Ingrese el teléfono"
                                           styleClass="minimalistic-field"
                                           stylesheets="@style.css"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                                <Button text="Eliminar"
                                        mnemonicParsing="false"
                                        onAction="#deleteSeller"
                                        styleClass="minimalistic-button"
                                        stylesheets="@style.css"
                                        GridPane.rowIndex="2" GridPane.columnIndex="2" />

                                <Label text="USUARIO:" underline="true"
                                       GridPane.rowIndex="3" GridPane.columnIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="user"
                                           promptText="Nombre de usuario"
                                           styleClass="minimalistic-field"
                                           stylesheets="@style.css"
                                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                                <Button text="Limpiar celdas"
                                        mnemonicParsing="false"
                                        onAction="#cleanCellsScreen"
                                        styleClass="minimalistic-button"
                                        stylesheets="@style.css"
                                        GridPane.rowIndex="3" GridPane.columnIndex="2" />

                                <Label text="ESTADO:" underline="true"
                                       GridPane.rowIndex="4" GridPane.columnIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cbState"
                                          promptText="Seleccione un estado"
                                          GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            </children>
                        </GridPane>

                        <TableView fx:id="tableSellers"
                                   prefHeight="220.0"
                                   prefWidth="640.0">
                            <VBox.margin>
                                <Insets left="20.0" right="20.0" top="5.0" bottom="20.0" />
                            </VBox.margin>
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="100.0" text="#Vendedor" />
                                <TableColumn fx:id="colDni" prefWidth="120.0" text="INE" />
                                <TableColumn fx:id="colName" prefWidth="150.0" text="nombre" />
                                <TableColumn fx:id="colPhone" prefWidth="140.0" text="telefono" />
                                <TableColumn fx:id="colState" prefWidth="120.0" text="estado" />
                            </columns>
                        </TableView>

                    </children>
                </VBox>
            </children>
        </Pane>
    </children>
</GridPane>
