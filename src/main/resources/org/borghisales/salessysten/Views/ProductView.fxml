<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="rootPane"
            prefHeight="500.0" prefWidth="750.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.ProductController">

    <top>
        <VBox style="-fx-padding: 15 20 10 20;">
            <AnchorPane>
                <Button fx:id="btnReturn"
                        text="← VOLVER"
                        onAction="#returnToMenu"
                        AnchorPane.leftAnchor="0.0"
                        AnchorPane.topAnchor="5.0"
                        prefHeight="30.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #aaa; -fx-border-color: #555; -fx-border-radius: 5; -fx-cursor: hand;">
                    <font><Font name="Segoe UI Semibold" size="12"/></font>
                </Button>

                <Label text="GESTIÓN DE PRODUCTOS" textFill="WHITE"
                       AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" alignment="CENTER" mouseTransparent="true">
                    <font>
                        <Font name="Segoe UI Semibold" size="24.0" />
                    </font>
                    <effect>
                        <DropShadow color="#0000004d" height="10.0" radius="4.5" width="10.0" />
                    </effect>
                </Label>
            </AnchorPane>

            <Separator style="-fx-background-color: #444; -fx-opacity: 0.5;">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Separator>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">

            <HBox spacing="30" alignment="CENTER_LEFT">

                <GridPane hgap="15" vgap="15" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="NOMBRE:" textFill="#dcdcdc" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="13"/></font>
                    </Label>
                    <TextField fx:id="name" promptText="Ej. Laptop HP"
                               style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                               prefHeight="30" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="MARCA:" textFill="#dcdcdc" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="13"/></font>
                    </Label>
                    <ComboBox fx:id="cbBrand" promptText="Seleccione..."
                              style="-fx-background-color: #333; -fx-mark-color: white; -fx-text-base-color: white;"
                              prefHeight="30" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="PRECIO:" textFill="#dcdcdc" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="13"/></font>
                    </Label>
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <TextField fx:id="price" promptText="0.00"
                                   style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                                   prefHeight="30" prefWidth="120"/>

                        <Label text="STOCK:" textFill="#dcdcdc">
                            <font><Font name="Segoe UI Bold" size="13"/></font>
                            <HBox.margin><Insets left="10"/></HBox.margin>
                        </Label>
                        <TextField fx:id="stock" promptText="0"
                                   style="-fx-background-color: #333; -fx-text-fill: white; -fx-background-radius: 5;"
                                   prefHeight="30" prefWidth="100"/>
                    </HBox>

                    <Label text="ESTADO:" textFill="#dcdcdc" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <font><Font name="Segoe UI Bold" size="13"/></font>
                    </Label>
                    <ComboBox fx:id="cbState"
                              style="-fx-background-color: #333; -fx-mark-color: white; -fx-text-base-color: white;"
                              prefHeight="30" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="12" minWidth="150" alignment="TOP_CENTER">
                    <Button fx:id="btnAdd" text="AÑADIR" onAction="#addProduct"
                            prefHeight="35" maxWidth="Infinity"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;"/>

                    <Button fx:id="btnUpdate" text="ACTUALIZAR" onAction="#updateProduct"
                            prefHeight="35" maxWidth="Infinity"
                            style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;"/>

                    <Button fx:id="btnDelete" text="ELIMINAR" onAction="#deleteProduct"
                            prefHeight="35" maxWidth="Infinity"
                            style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;"/>

                    <Button fx:id="btnClear" text="LIMPIAR" onAction="#cleanCellsScreen"
                            prefHeight="35" maxWidth="Infinity"
                            style="-fx-background-color: #424242; -fx-text-fill: #aaa; -fx-background-radius: 5;"/>
                </VBox>
            </HBox>

            <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #2b2b2b; -fx-base: #2b2b2b; -fx-control-inner-background: #2b2b2b; -fx-table-cell-border-color: transparent; -fx-table-header-border-color: transparent;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" maxWidth="50" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colName" text="NOMBRE" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colBrand" text="MARCA" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colPrice" text="PRECIO" maxWidth="100" style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colStock" text="STOCK" maxWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colState" text="ESTADO" maxWidth="100" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>

        </VBox>
    </center>
</BorderPane>