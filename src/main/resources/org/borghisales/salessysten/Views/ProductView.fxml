<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Group?>

<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.ProductController"
           prefWidth="720.0" prefHeight="480.0"
           alignment="CENTER">

    <children>
        <Group>
            <children>
                <AnchorPane fx:id="rootPane" prefHeight="480.0" prefWidth="720.0">

                    <Label alignment="CENTER"
                           layoutX="160.0" layoutY="10.0"
                           prefHeight="30.0" prefWidth="400.0"
                           text="GESTIÓN DE PRODUCTOS"
                           underline="true">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>

                    <Label layoutX="40.0" layoutY="60.0"
                           prefHeight="22.0" prefWidth="90.0"
                           text="NOMBRE:" underline="true">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="name"
                               layoutX="150.0" layoutY="56.0"
                               prefHeight="25.0" prefWidth="320.0" />

                    <Label layoutX="40.0" layoutY="90.0"
                           prefHeight="22.0" prefWidth="90.0"
                           text="MARCA:" underline="true">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <ComboBox fx:id="cbBrand"
                              layoutX="150.0" layoutY="86.0"
                              prefHeight="25.0" prefWidth="320.0" />

                    <Label layoutX="40.0" layoutY="120.0"
                           prefHeight="22.0" prefWidth="90.0"
                           text="PRECIO:" underline="true">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="price"
                               layoutX="150.0" layoutY="116.0"
                               prefHeight="25.0" prefWidth="320.0" />

                    <Label layoutX="40.0" layoutY="150.0"
                           prefHeight="22.0" prefWidth="120.0"
                           text="INVENTARIO:" underline="true">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <TextField fx:id="stock"
                               layoutX="150.0" layoutY="146.0"
                               prefHeight="25.0" prefWidth="320.0" />

                    <Label layoutX="40.0" layoutY="180.0"
                           prefHeight="22.0" prefWidth="90.0"
                           text="ESTADO:" underline="true">
                        <font><Font size="17.0" /></font>
                    </Label>
                    <ComboBox fx:id="cbState"
                              layoutX="150.0" layoutY="176.0"
                              prefHeight="25.0" prefWidth="320.0" />


                    <Button layoutX="500.0" layoutY="52.0"
                            mnemonicParsing="false"
                            onAction="#addProduct"
                            prefHeight="32.0" prefWidth="130.0"
                            text="AÑADIR" />

                    <Button layoutX="500.0" layoutY="90.0"
                            mnemonicParsing="false"
                            onAction="#updateProduct"
                            prefHeight="32.0" prefWidth="130.0"
                            text="ACTUALIZAR" />

                    <Button layoutX="500.0" layoutY="127.0"
                            mnemonicParsing="false"
                            onAction="#deleteProduct"
                            prefHeight="32.0" prefWidth="130.0"
                            text="ELIMINAR" />

                    <Button layoutX="500.0" layoutY="166.0"
                            mnemonicParsing="false"
                            onAction="#cleanCellsScreen"
                            prefHeight="32.0" prefWidth="130.0"
                            text="LIMPIAR CELDAS" />

                    <TableView fx:id="tableProducts"
                               layoutX="30.0" layoutY="220.0"
                               prefHeight="230.0" prefWidth="660.0">
                        <columns>
                            <TableColumn fx:id="colId"
                                         prefWidth="80.0"
                                         text="ID" />
                            <TableColumn fx:id="colName"
                                         prefWidth="160.0"
                                         text="NOMBRE" />
                            <TableColumn fx:id="colBrand"
                                         prefWidth="120.0"
                                         text="MARCA" />
                            <TableColumn fx:id="colPrice"
                                         prefWidth="100.0"
                                         text="PRECIO" />
                            <TableColumn fx:id="colStock"
                                         prefWidth="100.0"
                                         text="STOCK" />
                            <TableColumn fx:id="colState"
                                         prefWidth="100.0"
                                         text="ESTADO" />
                        </columns>
                    </TableView>

                </AnchorPane>
            </children>
        </Group>
    </children>
</StackPane>
