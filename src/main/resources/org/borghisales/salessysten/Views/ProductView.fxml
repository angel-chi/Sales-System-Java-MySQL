<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ProductController">
   <children>
      <AnchorPane prefHeight="484.0" prefWidth="663.0">
         <children>
            <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addProduct" prefHeight="32.0" prefWidth="101.0" text="AÑADIR" />
            <TableView fx:id="tableProducts" layoutX="26.0" layoutY="228.0" prefHeight="221.0" prefWidth="602.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="ID" />
                  <TableColumn fx:id="colName" prefWidth="111.0" text="NOMBRE" />
                  <TableColumn fx:id="colPrice" prefWidth="124.0" text="PRECIO" />
                  <TableColumn fx:id="colStock" prefWidth="124.0" text="DISPONIBLE" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="ESTADO" />
               </columns>
            </TableView>
            <Label layoutX="43.0" layoutY="58.0" prefHeight="17.0" prefWidth="100.0" text="NOMBRE:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="43.0" layoutY="93.0" prefHeight="26.0" prefWidth="68.0" text="PRECIO:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="43.0" layoutY="130.0" prefHeight="26.0" prefWidth="110.0" text="DISPONIBLE:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="name" layoutX="153.0" layoutY="57.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="price" layoutX="153.0" layoutY="93.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="stock" layoutX="153.0" layoutY="130.0" prefHeight="25.0" prefWidth="289.0" />
            <Button layoutX="458.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateProduct" prefHeight="32.0" prefWidth="101.0" text="ACTUALIZAR" />
            <Button layoutX="458.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteProduct" prefHeight="32.0" prefWidth="101.0" text="BORRAR" />
            <Button layoutX="458.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="101.0" text="LIMPIAR" />
            <ComboBox fx:id="cbState" layoutX="153.0" layoutY="169.0" prefHeight="25.0" prefWidth="289.0" />
            <Label layoutX="43.0" layoutY="170.0" prefHeight="17.0" prefWidth="70.0" text="ESTADO:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="200.0" layoutY="10.0" prefHeight="30.0" prefWidth="270.0" text="GESTIÓN DE PRODUCTOS" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
