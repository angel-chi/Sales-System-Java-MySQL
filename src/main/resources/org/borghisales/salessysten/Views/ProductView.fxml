<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Reflection?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ProductController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="663.0">
         <children>
            <Button layoutX="576.0" layoutY="16.0" mnemonicParsing="false" onAction="#backToMenu" text="Regresar" />
            <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addProduct" prefHeight="32.0" prefWidth="154.0" text="AGREGAR" />
            <TableView fx:id="tableProducts" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="26.0" AnchorPane.rightAnchor="26.0" AnchorPane.topAnchor="228.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="idProducto" />
                  <TableColumn fx:id="colName" prefWidth="111.0" text="nombre" />
                  <TableColumn fx:id="colPrice" prefWidth="124.0" text="precio" />
                  <TableColumn fx:id="colStock" prefWidth="124.0" text="existencia" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Label layoutX="33.0" layoutY="72.0" prefHeight="24.0" prefWidth="77.0" text="NOMBRE:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="45.0" layoutY="96.0" prefHeight="26.0" prefWidth="68.0" text="PRECIO:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="21.0" layoutY="126.0" prefHeight="26.0" prefWidth="102.0" text="CANTIDAD:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="nombre" layoutX="120.0" layoutY="66.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="precio" layoutX="121.0" layoutY="96.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="existencia" layoutX="120.0" layoutY="126.0" prefHeight="25.0" prefWidth="289.0" />
            <Button layoutX="458.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateProduct" prefHeight="32.0" prefWidth="154.0" text="ACTUALIZAR" />
            <Button layoutX="458.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteProduct" prefHeight="32.0" prefWidth="154.0" text="ELIMINAR" />
            <Button layoutX="458.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="154.0" text="LIMPIAR" />
            <ComboBox fx:id="cbState" layoutX="121.0" layoutY="158.0" prefHeight="26.0" prefWidth="290.0" />
            <Label layoutX="40.0" layoutY="159.0" prefHeight="24.0" prefWidth="78.0" text="ESTADO:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="127.0" layoutY="14.0" prefHeight="30.0" prefWidth="400.0" text="ADMINISTRACION DE PRODUCTOS" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
               <effect>
                  <Reflection topOpacity="0.0" />
               </effect>
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor>
            </Label>
         </children>
      </AnchorPane>
   </children>
</StackPane>
