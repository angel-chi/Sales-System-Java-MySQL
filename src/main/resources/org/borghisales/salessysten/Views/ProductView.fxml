<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.ProductController">

    <top>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>
            <Label text="GESTIÓN DE PRODUCTOS" underline="true">
                <font>
                    <Font size="20.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="20" alignment="TOP_LEFT">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="NOMBRE:" underline="true" minWidth="60">
                            <font>
                                <Font size="17.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="name" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="PRECIO:" underline="true" minWidth="60">
                            <font>
                                <Font size="17.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="price" HBox.hgrow="ALWAYS"/>
                    </HBox>


                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="EXISTENCIAS:" underline="true" minWidth="60">
                            <font>
                                <Font size="17.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="stock" HBox.hgrow="ALWAYS"/>
                    </HBox>


                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="ESTADO:" underline="true" minWidth="60">
                            <font>
                                <Font size="17.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="cbState" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>


                <VBox spacing="10" alignment="TOP_CENTER" minWidth="120" HBox.hgrow="NEVER">
                    <Button text="AGREGAR" onAction="#addProduct" maxWidth="Infinity" prefHeight="32"/>
                    <Button text="ACTUALIZAR" onAction="#updateProduct" maxWidth="Infinity" prefHeight="32"/>
                    <Button text="ELIMINAR" onAction="#deleteProduct" maxWidth="Infinity" prefHeight="32"/>
                    <Button text="LIMPIAR" onAction="#cleanCellsScreen" maxWidth="Infinity" prefHeight="32"/>
                </VBox>
            </HBox>

            <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="IdProducto" prefWidth="120.0"/>
                    <TableColumn fx:id="colName" text="Nombre" prefWidth="150.0"/>
                    <TableColumn fx:id="colPrice" text="Precio" prefWidth="120.0"/>
                    <TableColumn fx:id="colStock" text="Existencias" prefWidth="120.0"/>
                    <TableColumn fx:id="colState" text="Estado" prefWidth="120.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>