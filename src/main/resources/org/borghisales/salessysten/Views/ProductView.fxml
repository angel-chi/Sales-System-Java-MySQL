<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ProductController">
   <children>
      <AnchorPane prefHeight="484.0" prefWidth="663.0">
         <children>
            <Button layoutX="458.0" layoutY="52.0" mnemonicParsing="false" onAction="#addProduct" prefHeight="32.0" prefWidth="130.0" text="AÑADIR" />
            <TableView fx:id="tableProducts" layoutX="26.0" layoutY="228.0" prefHeight="221.0" prefWidth="602.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="ID-Producto" />
                  <TableColumn fx:id="colName" prefWidth="111.0" text="Nombre" />
                  <TableColumn fx:id="colPrice" prefWidth="124.0" text="Precio" />
                  <TableColumn fx:id="colStock" prefWidth="124.0" text="Cantidad" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
               </columns>
            </TableView>
            <Label layoutX="45.0" layoutY="70.0" prefHeight="17.0" prefWidth="100.0" text="NOMBRE:" underline="true">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label layoutX="45.0" layoutY="96.0" prefHeight="26.0" prefWidth="100.0" text="PRECIO:" underline="true">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label layoutX="45.0" layoutY="122.0" prefHeight="26.0" prefWidth="123.0" text="INVENTARIO:" underline="true">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="name" layoutX="170.0" layoutY="66.0" prefHeight="25.0" prefWidth="250.0" />
            <TextField fx:id="price" layoutX="170.0" layoutY="96.0" prefHeight="25.0" prefWidth="250.0" />
            <TextField fx:id="stock" layoutX="170.0" layoutY="126.0" prefHeight="25.0" prefWidth="250.0" />
            <Button layoutX="458.0" layoutY="90.0" mnemonicParsing="false" onAction="#updateProduct" prefHeight="32.0" prefWidth="130.0" text="ACTUALIZAR" />
            <Button layoutX="458.0" layoutY="127.0" mnemonicParsing="false" onAction="#deleteProduct" prefHeight="32.0" prefWidth="130.0" text="ELIMINAR" />
            <Button layoutX="458.0" layoutY="166.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="130.0" text="LIMPIAR CELDAS" />
            <ComboBox fx:id="cbState" layoutX="170.0" layoutY="158.0" prefHeight="25.0" prefWidth="250.0" />
            <Label layoutX="45.0" layoutY="155.0" prefHeight="17.0" prefWidth="100.0" text="ESTADO:" underline="true">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label layoutX="40.0" layoutY="200.0" prefHeight="17.0" prefWidth="110.0" text="DESCUENTO (%):">
               <font>
                  <Font name="System Bold Italic" size="13.0" />
               </font></Label>
            <TextField fx:id="txtDiscountPercentage" layoutX="145.0" layoutY="196.0" prefHeight="26.0" prefWidth="84.0" />
            <Label alignment="CENTER" layoutX="151.0" layoutY="10.0" prefHeight="30.0" prefWidth="288.0" text="GESTIÓN DE PRODUCTOS" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Button fx:id="back" layoutX="30.0" layoutY="12.0" mnemonicParsing="false" onAction="#back" text="ATRAS" />
            <TextField fx:id="txtDiscountMinQty" layoutX="355.0" layoutY="196.0" prefHeight="26.0" prefWidth="84.0" />
            <Label layoutX="245.0" layoutY="201.0" prefHeight="17.0" prefWidth="110.0" text="CANTIDAD MIN:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font></Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
