<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ProductController">
   <children>
      <AnchorPane prefHeight="484.0" prefWidth="663.0">
         <children>
            <Button layoutX="479.0" layoutY="78.0" mnemonicParsing="false" onAction="#addProduct" prefHeight="32.0" prefWidth="101.0" text="AÑADIR" />
            <TableView fx:id="tableProducts" layoutX="26.0" layoutY="228.0" prefHeight="221.0" prefWidth="602.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="120.0" text="ID Producto" />
                  <TableColumn fx:id="colName" prefWidth="111.0" text="Nombre" />
                  <TableColumn fx:id="colPrice" prefWidth="124.0" text="Precio" />
                  <TableColumn fx:id="colStock" prefWidth="124.0" text="Existencia" />
                  <TableColumn fx:id="colState" prefWidth="122.0" text="Estado" />
               </columns>
            </TableView>
            <Label layoutX="43.0" layoutY="85.0" prefHeight="26.0" prefWidth="85.0" text="NOMBRE" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="43.0" layoutY="119.0" prefHeight="26.0" prefWidth="68.0" text="PRECIO" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label layoutX="44.0" layoutY="148.0" prefHeight="26.0" prefWidth="101.0" text="EXISTENCIA:" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="name" layoutX="159.0" layoutY="85.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="price" layoutX="159.0" layoutY="120.0" prefHeight="25.0" prefWidth="289.0" />
            <TextField fx:id="stock" layoutX="159.0" layoutY="149.0" prefHeight="25.0" prefWidth="289.0" />
            <Button layoutX="479.0" layoutY="110.0" mnemonicParsing="false" onAction="#updateProduct" prefHeight="32.0" prefWidth="101.0" text="ACTUALIZAR" />
            <Button layoutX="479.0" layoutY="145.0" mnemonicParsing="false" onAction="#deleteProduct" prefHeight="32.0" prefWidth="101.0" text="ELIMINAR" />
            <Button layoutX="480.0" layoutY="179.0" mnemonicParsing="false" onAction="#cleanCellsScreen" prefHeight="32.0" prefWidth="122.0" text="LIMPIAR CELDAS" />
            <ComboBox fx:id="cbState" layoutX="161.0" layoutY="182.0" prefHeight="25.0" prefWidth="289.0" />
            <Label layoutX="43.0" layoutY="181.0" prefHeight="26.0" prefWidth="85.0" text="ESTADO" underline="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="211.0" layoutY="30.0" prefHeight="30.0" prefWidth="242.0" text="GESTIÓN DE PRODUCTOS" underline="true">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
