<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ConfiguracionAdminController">
   <children>
      <Label layoutX="188.0" layoutY="14.0" text="Configuraciones de Administrador">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
        <tabs>
          <Tab text="IVA">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Label layoutX="220.0" layoutY="100.0" text="Porcentaje de IVA:">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <TextField fx:id="campoPorcentajeIva" layoutX="400.0" layoutY="100.0" />
                        <Button layoutX="330.0" layoutY="160.0" mnemonicParsing="false" onAction="#guardarIva" text="Guardar" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="Códigos de Descuento">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tablaDescuentos" layoutX="14.0" layoutY="14.0" prefHeight="410.0" prefWidth="350.0">
                          <columns>
                            <TableColumn fx:id="columnaCodigo" prefWidth="100.0" text="Código" />
                            <TableColumn fx:id="columnaPorcentaje" prefWidth="80.0" text="Porcentaje" />
                              <TableColumn fx:id="columnaEstado" prefWidth="75.0" text="Estado" />
                              <TableColumn fx:id="columnaExpiracion" prefWidth="95.0" text="Expiración" />
                          </columns>
                        </TableView>
                        <Label layoutX="380.0" layoutY="40.0" text="Código:" />
                        <TextField fx:id="campoCodigo" layoutX="470.0" layoutY="36.0" />
                        <Label layoutX="380.0" layoutY="86.0" text="Porcentaje:" />
                        <TextField fx:id="campoPorcentaje" layoutX="470.0" layoutY="82.0" />
                        <Label layoutX="380.0" layoutY="132.0" text="Estado:" />
                        <RadioButton fx:id="radioActivo" layoutX="470.0" layoutY="132.0" mnemonicParsing="false" selected="true" text="Activo">
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoEstado" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radioInactivo" layoutX="550.0" layoutY="132.0" mnemonicParsing="false" text="Inactivo" toggleGroup="$grupoEstado" />
                        <Label layoutX="380.0" layoutY="178.0" text="Fecha Expiración:" />
                        <DatePicker fx:id="pickerFechaExpiracion" layoutX="500.0" layoutY="174.0" />
                        <Button layoutX="395.0" layoutY="240.0" mnemonicParsing="false" onAction="#agregarDescuento" text="Agregar" />
                        <Button layoutX="485.0" layoutY="240.0" mnemonicParsing="false" onAction="#actualizarDescuento" text="Actualizar" />
                        <Button layoutX="585.0" layoutY="240.0" mnemonicParsing="false" onAction="#eliminarDescuento" text="Eliminar" />
                        <Button layoutX="395.0" layoutY="290.0" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
      <Button layoutX="691.0" layoutY="558.0" mnemonicParsing="false" onAction="#volverAtras" text="Regresar" />
   </children>
</AnchorPane>
