<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.HelpController">

    <top>
        <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="Infinity" prefHeight="80.0" prefWidth="600.0" text="AYUDA DEL SISTEMA" underline="false" BorderPane.alignment="CENTER">
            <font>
                <Font size="35.0" />
            </font>
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </Label>
    </top>

    <center>
        <VBox alignment="CENTER" prefHeight="361.0" prefWidth="602.0" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Imagen agregada -->
            <ImageView fitHeight="134.0" fitWidth="134.0" preserveRatio="true">
                <image>
                    <Image url="@../../../../images/sistema.png" />
                </image>
            </ImageView>

            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="34.0" prefWidth="589.0" text="Selecciona una opción de ayuda:">
            <font>
               <Font size="23.0" />
            </font></Label>

            <Button onAction="#openRepository" prefHeight="39.0" prefWidth="323.0" text="Abrir repositorio en GitHub">
            <font>
               <Font size="18.0" />
            </font></Button>

            <Button onAction="#closeWindow" prefHeight="39.0" prefWidth="237.0" text="Cerrar">
            <font>
               <Font size="18.0" />
            </font></Button>
        </VBox>
    </center>

</BorderPane>
