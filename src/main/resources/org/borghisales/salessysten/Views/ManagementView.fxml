<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.ManagementController">

    <children>

        <TabPane fx:id="tabPaneManage" tabClosingPolicy="UNAVAILABLE"
                 AnchorPane.topAnchor="0.0"
                 AnchorPane.bottomAnchor="0.0"
                 AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0">

            <tabs>
                <Tab text="MENU">
                    <content>
                        <AnchorPane>
                            <children>


                                <Button text="AYUDA" onAction="#help"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="40.0" />

                                <Button text="SALIR" onAction="#exit"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="150.0" />

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>



                <Tab text="VENTAS">
                    <content>
                        <AnchorPane>
                            <children>

                                <Button text="CREAR VENTA" onAction="#openGenerateSale"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="80.0" />

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>



                <Tab text="GESTIÓN">
                    <content>
                        <AnchorPane>
                            <children>

                                <Button text="CLIENTE" onAction="#openCustomer"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="20.0" />

                                <Button text="PRODUCTO" onAction="#openProduct"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="120.0" />

                                <Button fx:id="sellerButton" text="VENDEDOR" onAction="#openSeller"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="220.0" />

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>


                <Tab text="INFORMES">
                    <content>
                        <AnchorPane>
                            <children>

                                <Button text="INFORME DE LAS VENTAS" onAction="#openSalesReport"
                                        prefHeight="70.0"
                                        AnchorPane.leftAnchor="40.0"
                                        AnchorPane.rightAnchor="40.0"
                                        AnchorPane.topAnchor="80.0" />

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

    </children>
</AnchorPane>
