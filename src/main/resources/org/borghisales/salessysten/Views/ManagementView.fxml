<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.ManagementController">

    <center>
        <TabPane fx:id="tabPaneManage" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="MENÚ">
                    <content>
                        <BorderPane>
                            <center>
                                <VBox alignment="CENTER" spacing="20.0">
                                    <Button mnemonicParsing="false"
                                            onAction="#help"
                                            prefHeight="50.0"
                                            prefWidth="200.0"
                                            text="AYUDA" />
                                    <Button mnemonicParsing="false"
                                            onAction="#exit"
                                            prefHeight="50.0"
                                            prefWidth="200.0"
                                            text="SALIR" />
                                </VBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>


                <Tab text="VENTAS">
                    <content>
                        <BorderPane>
                            <center>
                                <VBox alignment="CENTER" spacing="20.0">
                                    <Button mnemonicParsing="false"
                                            onAction="#openGenerateSale"
                                            prefHeight="50.0"
                                            prefWidth="220.0"
                                            text="REGISTRAR VENTA" />
                                </VBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>


                <Tab text="GESTIÓN">
                    <content>
                        <BorderPane>
                            <center>
                                <VBox alignment="CENTER" spacing="15.0">
                                    <Button mnemonicParsing="false"
                                            onAction="#openCustomer"
                                            prefHeight="50.0"
                                            prefWidth="220.0"
                                            text="CLIENTE" />

                                    <Button mnemonicParsing="false"
                                            onAction="#openProduct"
                                            prefHeight="50.0"
                                            prefWidth="220.0"
                                            text="PRODUCTO" />

                                    <Button fx:id="sellerButton"
                                            mnemonicParsing="false"
                                            onAction="#openSeller"
                                            prefHeight="50.0"
                                            prefWidth="220.0"
                                            text="VENDEDOR" />
                                </VBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>


                <Tab text="REPORTES">
                    <content>
                        <BorderPane>
                            <center>
                                <VBox alignment="CENTER" spacing="20.0">
                                    <Button mnemonicParsing="false"
                                            onAction="#openSalesReport"
                                            prefHeight="50.0"
                                            prefWidth="240.0"
                                            text="REPORTES DE VENTAS" />
                                </VBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>

</BorderPane>
