<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="407.0" prefWidth="267.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
   <children>
      <TabPane fx:id="tabPaneManage" prefHeight="400.0" prefWidth="298.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <tabs>
          <Tab text="MENÚ">
            <content>
                  <BorderPane>
                     <center>
                        <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
                           <children>
                              <Button mnemonicParsing="false" onAction="#help" prefHeight="60.0" prefWidth="240.0" text="AYUDA" textAlignment="CENTER" />
                              <Button mnemonicParsing="false" onAction="#exit" prefHeight="60.0" prefWidth="240.0" text="CERRAR SESIÓN">
                                 <font>
                                    <Font name="System Italic" size="13.0" />
                                 </font>
                              </Button>
                           </children>
                           <padding>
                              <Insets bottom="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </center>
                  </BorderPane>
            </content>
          </Tab>
          <Tab text="VENTAS">
            <content>
                  <BorderPane>
                     <top>
                        <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </top>
                     <center>
                        <Button mnemonicParsing="false" onAction="#openGenerateSale" prefHeight="60.0" prefWidth="240.0" text="GENERAR VENTA" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="20.0" top="20.0" />
                           </padding>
                        </Button>
                     </center>
                  </BorderPane>
            </content>
          </Tab>
            <Tab text="GESTION">
              <content>
                  <BorderPane>
                     <center>
                        <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
                           <children>
                              <Button alignment="CENTER" mnemonicParsing="false" onAction="#openCustomer" prefHeight="60.0" prefWidth="240.0" text="CLIENTES" />
                              <Button alignment="CENTER" mnemonicParsing="false" onAction="#openProduct" prefHeight="60.0" prefWidth="240.0" text="PRODUCTOS" />
                              <Button fx:id="sellerButton" alignment="CENTER" mnemonicParsing="false" onAction="#openSeller" prefHeight="60.0" prefWidth="240.0" text="VENDEDORES" />
                           </children>
                           <padding>
                              <Insets bottom="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </center>
                  </BorderPane>
              </content>
            </Tab>
            <Tab text="REPORTES">
              <content>
                  <BorderPane>
                     <top>
                        <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </top>
                     <center>
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#openSalesReport" prefHeight="60.0" prefWidth="240.0" text="REPORTE DE VENTAS" BorderPane.alignment="CENTER" />
                     </center>
                  </BorderPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
