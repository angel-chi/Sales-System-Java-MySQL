<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
    <children>
        <TabPane fx:id="tabPaneManage" prefHeight="650.0" prefWidth="650.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="MENÚ">
                    <content>
                        <VBox alignment="CENTER" spacing="20">
                            <children>
                                <Button onAction="#help" prefHeight="70" prefWidth="160" text="AYUDA" />
                                <Button onAction="#exit" prefHeight="70" prefWidth="160" text="SALIR" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="VENTAS">
                    <content>
                        <VBox alignment="CENTER" spacing="20">
                            <children>
                                <Button onAction="#openGenerateSale" prefHeight="70" prefWidth="160" text="GENERAR VENTA" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="GESTIÓN">
                    <content>
                        <VBox alignment="CENTER" spacing="20">
                            <children>
                                <Button onAction="#openCustomer" prefHeight="70" prefWidth="160" text="CLIENTES" />
                                <Button onAction="#openProduct" prefHeight="70" prefWidth="160" text="PRODUCTOS" />
                                <Button fx:id="sellerButton" onAction="#openSeller" prefHeight="70" prefWidth="160" text="VENDEDORES" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="REPORTES">
                    <content>
                        <VBox alignment="CENTER" spacing="20">
                            <children>
                                <Button onAction="#openSalesReport" prefHeight="70" prefWidth="160" text="REPORTE DE VENTAS" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
