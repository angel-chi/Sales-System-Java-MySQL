<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="407.0" prefWidth="305.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
   <children>
      <TabPane fx:id="tabPaneManage" layoutY="3.0" prefHeight="430.0" prefWidth="363.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="MENU">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="342.0" prefWidth="525.0">
                     <children>
                        <Button layoutX="97.0" layoutY="61.0" mnemonicParsing="false" onAction="#help" prefHeight="70.0" prefWidth="160.0" text="AYUDA" />
                        <Button layoutX="97.0" layoutY="173.0" mnemonicParsing="false" onAction="#exit" prefHeight="70.0" prefWidth="160.0" text="SALIR" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="VENTAS">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="412.0">
                     <children>
                        <Button layoutX="102.0" layoutY="130.0" mnemonicParsing="false" onAction="#openGenerateSale" prefHeight="70.0" prefWidth="160.0" text="GENERAR VENTA" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab text="AREA DE GESTION">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Button layoutX="102.0" layoutY="46.0" mnemonicParsing="false" onAction="#openCustomer" prefHeight="70.0" prefWidth="160.0" text="CLIENTES" />
                        <Button layoutX="102.0" layoutY="151.0" mnemonicParsing="false" onAction="#openProduct" prefHeight="70.0" prefWidth="160.0" text="PRODUCTOS" />
                        <Button fx:id="sellerButton" layoutX="102.0" layoutY="264.0" mnemonicParsing="false" onAction="#openSeller" prefHeight="70.0" prefWidth="160.0" text="CAJEROS" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            <Tab text="REPORTES">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Button layoutX="84.0" layoutY="165.0" mnemonicParsing="false" onAction="#openSalesReport" prefHeight="70.0" prefWidth="195.0" text="REPORTES DE VENTAS" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
