<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="407.0" prefWidth="305.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
    <children>
        <TabPane fx:id="tabPaneManage" prefHeight="400.0" prefWidth="315.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="MENU">
                    <content>
                        <VBox minHeight="0.0" minWidth="0.0" prefHeight="342.0" prefWidth="525.0"
                              spacing="20" alignment="CENTER">
                            <children>
                                <Button mnemonicParsing="false" onAction="#openHelp"
                                        prefHeight="70.0" prefWidth="160.0" text="AYUDA" />
                                <Button mnemonicParsing="false" onAction="#exit"
                                        prefHeight="70.0" prefWidth="160.0" text="SALIR" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="VENTAS">
                    <content>
                        <VBox minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"
                              spacing="20" alignment="CENTER">
                            <children>
                                <Button mnemonicParsing="false" onAction="#openGenerateSale"
                                        prefHeight="70.0" prefWidth="160.0" text="GENERAR VENTA" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="GESTION">
                    <content>
                        <VBox minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"
                              spacing="20" alignment="CENTER">
                            <children>
                                <Button mnemonicParsing="false" onAction="#openCustomer"
                                        prefHeight="70.0" prefWidth="160.0" text="CLIENTE" />
                                <Button mnemonicParsing="false" onAction="#openProduct"
                                        prefHeight="70.0" prefWidth="160.0" text="PRODUCTO" />
                                <Button fx:id="sellerButton" mnemonicParsing="false" onAction="#openSeller"
                                        prefHeight="70.0" prefWidth="160.0" text="VENDEDOR" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="REPORTES">
                    <content>
                        <VBox minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"
                              spacing="20" alignment="CENTER">
                            <children>
                                <Button mnemonicParsing="false" onAction="#openSalesReport"
                                        prefHeight="70.0" prefWidth="160.0" text="REPORTE DE VENTAS" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </children>
</AnchorPane>
