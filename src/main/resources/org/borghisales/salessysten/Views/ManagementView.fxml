<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">

    <children>
        <TabPane fx:id="tabPaneManage" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <tabs>

                <!-- MENÚ -->
                <Tab text="MENÚ">
                    <content>
                        <StackPane>
                            <VBox alignment="CENTER" prefHeight="600.0" prefWidth="400.0" spacing="25">
                                <Button onAction="#help" prefHeight="100.0" prefWidth="190.0" text="AYUDA" />
                                <Button onAction="#exit" prefHeight="100.0" prefWidth="190.0" text="SALIDA" />
                            </VBox>
                        </StackPane>
                    </content>
                </Tab>

                <!-- VENTAS -->
                <Tab text="VENTAS">
                    <content>
                        <StackPane>
                            <VBox alignment="CENTER" spacing="25">
                                <Button onAction="#openGenerateSale" prefHeight="60" prefWidth="160" text="GENERAR VENTAS" />
                            </VBox>
                        </StackPane>
                    </content>
                </Tab>

                <!-- ADMINISTRACIÓN -->
                <Tab text="ADMINISTRACIÓN">
                    <content>
                        <StackPane>
                            <VBox alignment="CENTER" spacing="25">
                                <Button onAction="#openCustomer" prefHeight="60" prefWidth="160" text="CLIENTE" />

                                <Button onAction="#openProduct" prefHeight="60" prefWidth="160" text="PRODUCTO" />

                                <Button fx:id="sellerButton" onAction="#openSeller" prefHeight="60" prefWidth="160" text="VENDEDOR" />
                            </VBox>
                        </StackPane>
                    </content>
                </Tab>

                <!-- REPORTES -->
                <Tab text="REPORTES">
                    <content>
                        <StackPane>
                            <VBox alignment="CENTER" spacing="25">
                                <Button onAction="#openSalesReport" prefHeight="60" prefWidth="160" text="REPORTE DE VENTAS" />
                            </VBox>
                        </StackPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </children>

</AnchorPane>
