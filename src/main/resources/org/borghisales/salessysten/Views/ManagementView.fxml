<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
   <children>
      <TabPane fx:id="tabPaneManage" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="MENU">
            <content>
              <AnchorPane>
                     <children>
                        <Button layoutX="78.0" layoutY="76.0" mnemonicParsing="false" onAction="#help" prefHeight="70.0" prefWidth="160.0" text="AYUDA" />
                        <Button layoutX="78.0" layoutY="219.0" mnemonicParsing="false" onAction="#exit" prefHeight="70.0" prefWidth="160.0" text="SALIR" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="VENTAS">
            <content>
              <AnchorPane>
                     <children>
                        <Button layoutX="78.0" layoutY="151.0" mnemonicParsing="false" onAction="#openGenerateSale" prefHeight="70.0" prefWidth="160.0" text="GENERAR VENTA" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab text="ADMINISTRACION">
              <content>
                <AnchorPane>
                     <children>
                        <Button layoutX="78.0" layoutY="46.0" mnemonicParsing="false" onAction="#openCustomer" prefHeight="70.0" prefWidth="160.0" text="CLIENTE" />
                        <Button fx:id="sellerButton" layoutX="78.0" layoutY="151.0" mnemonicParsing="false" onAction="#openSeller" prefHeight="70.0" prefWidth="160.0" text="VENDEDORES" />
                         <Button fx:id="productButton" layoutX="78.0" layoutY="264.0" mnemonicParsing="false" onAction="#openProduct" prefHeight="70.0" prefWidth="160.0" text="PRODUCTO" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            <Tab text="REPORTES">
              <content>
                <AnchorPane>
                     <children>
                        <Button layoutX="78.0" layoutY="151.0" mnemonicParsing="false" onAction="#openSalesReport" prefHeight="70.0" prefWidth="160.0" text="REPORTE DE VENTAS" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
