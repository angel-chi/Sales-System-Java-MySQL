<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ManagementController">
   <children>
      <TabPane fx:id="tabPaneManage" layoutY="3.0" prefHeight="650.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="MENU PRINCIPAL">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="342.0" prefWidth="525.0">
                     <children>
                        <Button layoutX="270.0" layoutY="133.0" mnemonicParsing="false" onAction="#help" prefHeight="70.0" prefWidth="160.0" text="AYUDA" />
                        <Button layoutX="270.0" layoutY="320.0" mnemonicParsing="false" onAction="#exit" prefHeight="70.0" prefWidth="160.0" text="SALIR" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="VENTAS">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="412.0">
                     <children>
                        <Button layoutX="212.0" layoutY="199.0" mnemonicParsing="false" onAction="#openGenerateSale" prefHeight="111.0" prefWidth="277.0" text="GENERAR VENTA" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab text="AREA DE GESTION">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Button layoutX="247.0" layoutY="114.0" mnemonicParsing="false" onAction="#openCustomer" prefHeight="70.0" prefWidth="216.0" text="CLIENTES" />
                        <Button layoutX="245.0" layoutY="219.0" mnemonicParsing="false" onAction="#openProduct" prefHeight="70.0" prefWidth="210.0" text="PRODUCTOS" />
                        <Button fx:id="sellerButton" layoutX="243.0" layoutY="310.0" mnemonicParsing="false" onAction="#openSeller" prefHeight="70.0" prefWidth="214.0" text="CAJEROS" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            <Tab text="REPORTES">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="619.0" prefWidth="679.0" style="-fx-background-image: ../images/report.png;">
                     <children>
                        <Button layoutX="172.0" layoutY="171.0" mnemonicParsing="false" onAction="#openSalesReport" prefHeight="70.0" prefWidth="357.0" text="REPORTES DE VENTAS" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
   <stylesheets>
      <URL value="@CSS/MainView.css" />
      <URL value="@CSS/MainView.css" />
   </stylesheets>
</AnchorPane>
