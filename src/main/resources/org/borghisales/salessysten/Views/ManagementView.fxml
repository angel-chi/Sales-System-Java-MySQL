<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- StackPane principal: centra automáticamente -->
<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.ManagementController"
           prefHeight="600.0" prefWidth="800.0">

    <!-- TabPane: ocupa el espacio disponible -->
    <TabPane fx:id="tabPaneManage" tabClosingPolicy="UNAVAILABLE">
        <tabs>

            <Tab text="MENÚ">
                <content>
                    <VBox alignment="CENTER" spacing="40">
                        <padding>
                            <Insets top="50" bottom="50" left="50" right="50"/>
                        </padding>
                        <Button mnemonicParsing="false" onAction="#help" prefHeight="70.0" prefWidth="200.0" text="AYUDA" />
                        <Button mnemonicParsing="false" onAction="#exit" prefHeight="70.0" prefWidth="200.0" text="SALIR" />
                    </VBox>
                </content>
            </Tab>

            <Tab text="VENTAS">
                <content>
                    <VBox alignment="CENTER" spacing="40">
                        <padding>
                            <Insets top="50" bottom="50" left="50" right="50"/>
                        </padding>
                        <Button mnemonicParsing="false" onAction="#openGenerateSale" prefHeight="70.0" prefWidth="200.0" text="GENERAR VENTA" />
                    </VBox>
                </content>
            </Tab>

            <Tab text="GESTIÓN">
                <content>
                    <!-- VBox: centra los 3 botones -->
                    <VBox alignment="CENTER" spacing="35">
                        <padding>
                            <Insets top="50" bottom="50" left="50" right="50"/>
                        </padding>
                        <Button mnemonicParsing="false" onAction="#openCustomer" prefHeight="70.0" prefWidth="200.0" text="CLIENTE" />
                        <Button mnemonicParsing="false" onAction="#openProduct" prefHeight="70.0" prefWidth="200.0" text="PRODUCTO" />
                        <Button fx:id="sellerButton" mnemonicParsing="false" onAction="#openSeller" prefHeight="70.0" prefWidth="200.0" text="VENDEDOR/A" />
                    </VBox>
                </content>
            </Tab>

            <Tab text="REPORTES">
                <content>
                    <VBox alignment="CENTER" spacing="40">
                        <padding>
                            <Insets top="50" bottom="50" left="50" right="50"/>
                        </padding>
                        <Button mnemonicParsing="false" onAction="#openSalesReport" prefHeight="70.0" prefWidth="200.0" text="INFORME DE VENTAS" />
                    </VBox>
                </content>
            </Tab>

        </tabs>
    </TabPane>

</StackPane>