<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="514.0" prefWidth="732.5" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.ReportsController">
    <tabs>
        <Tab text="HISTORIAL DE VENTAS">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="514.0" prefWidth="732.5">
                    <children>
                        <TableView fx:id="tableReport" prefHeight="550.0" prefWidth="715.0"
                                   AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="100.0">
                            <columns>
                                <TableColumn fx:id="colIdSales" prefWidth="75.0" text="idVentas" />
                                <TableColumn fx:id="colIdCustomer" prefWidth="75.0" text="idClitente" />
                                <TableColumn fx:id="colIdSeller" prefWidth="75.0" text="idVendedor" />
                                <TableColumn fx:id="colNumberSales" prefWidth="75.0" text="numeroVentas" />
                                <TableColumn fx:id="colSaleDate" prefWidth="75.0" text="fechaDeVenta" />
                                <TableColumn fx:id="colAmount" prefWidth="75.0" text="cantidad" />
                                <TableColumn fx:id="colState" prefWidth="75.0" text="estado" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Fecha mínima -->
                        <DatePicker fx:id="minDate" prefHeight="25.0" prefWidth="92.0"
                                    AnchorPane.topAnchor="40.0" AnchorPane.rightAnchor="190.0"/>

                        <!-- Fecha máxima -->
                        <DatePicker fx:id="maxDate" prefHeight="25.0" prefWidth="92.0"
                                    AnchorPane.topAnchor="40.0" AnchorPane.rightAnchor="100.0"/>

                        <!-- Monto mínimo -->
                        <TextField fx:id="minAmount" prefHeight="27.0" prefWidth="78.0"
                                   AnchorPane.topAnchor="40.0" AnchorPane.leftAnchor="150.0"/>

                        <!-- Monto máximo -->
                        <TextField fx:id="maxAmount" prefHeight="27.0" prefWidth="78.0"
                                   AnchorPane.topAnchor="40.0" AnchorPane.leftAnchor="250.0"/>

                        <!-- Labels -->
                        <Label text="CANTIDAD" underline="true" wrapText="true"
                               AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="205.0">
                            <font><Font size="15.0"/></font>
                        </Label>
                        <Label text="FECHA" underline="true" wrapText="true"
                               AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="175.0">
                            <font><Font size="15.0"/></font>
                        </Label>

                        <!-- Botón Filtrar -->
                        <Button text="FILTRO" mnemonicParsing="false" onAction="#onFilter"
                                prefHeight="25.0" prefWidth="92.0"
                                AnchorPane.topAnchor="40.0" AnchorPane.rightAnchor="5.0"/>

                        <!-- Botón Exportar -->
                        <Button text="EXPORTAR" mnemonicParsing="false" onAction="#onExport"
                                prefHeight="32.0" prefWidth="94.0"
                                AnchorPane.bottomAnchor="5.0" AnchorPane.rightAnchor="0.0"/>

                        <!-- ComboBox Tipo Export -->
                        <ComboBox fx:id="cbTypeExport" prefHeight="32.0" prefWidth="108.0" style="-fx-alignment: CENTER;"
                                  AnchorPane.bottomAnchor="5.0" AnchorPane.rightAnchor="100.0"/>

                        <!-- Icono -->
                        <ImageView fitHeight="87.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true"
                                   AnchorPane.topAnchor="5.0" AnchorPane.leftAnchor="5.0">
                            <image>
                                <Image url="@../../../../images/report.png"/>
                            </image>
                        </ImageView>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="ESTADISTICAS">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="1100.0">
                    <children>

                        <!-- Label PieChart -->
                        <Label layoutX="61.0" layoutY="61.0" text="CANTIDAD PRODUCTOS VENDIDOS" underline="true" wrapText="true">
                            <font><Font size="32.0"/></font>
                        </Label>


                        <PieChart fx:id="pieChartProducts" layoutX="14.0" layoutY="110.0" prefHeight="327.0" prefWidth="375.0" />


                        <Label layoutX="870.0" layoutY="61.0" text="VENTAS TOTALES" underline="true" wrapText="true">
                            <font><Font size="32.0"/></font>
                        </Label>

                        <LineChart fx:id="salesLineChart" createSymbols="false" layoutX="800.0" layoutY="110.0" legendVisible="false" prefHeight="317.0" prefWidth="345.5">
                            <xAxis>
                                <CategoryAxis fx:id="x_time" side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="y_amountSales" side="LEFT" />
                            </yAxis>
                        </LineChart>

                        <Label layoutX="970.0" layoutY="450.0" prefHeight="42.0" prefWidth="59.0" text="AÑO" underline="true" wrapText="true">
                            <font><Font size="23.0" /></font>
                        </Label>

                        <TextField fx:id="year" alignment="CENTER" editable="false" layoutX="945.0" layoutY="490.0" prefHeight="18.0" prefWidth="102.0" />
                        <Button layoutX="1055.0" layoutY="490.0" mnemonicParsing="false" onAction="#sumYear" text="-&gt;" />
                        <Button layoutX="910.0" layoutY="490.0" mnemonicParsing="false" onAction="#subtractYear" text="&lt;-" />

                        <Label layoutX="970.0" layoutY="520.0" prefHeight="42.0" prefWidth="59.0" text="MES" underline="true" wrapText="true">
                            <font><Font size="23.0" /></font>
                        </Label>
                        <TextField fx:id="month" alignment="CENTER" editable="false" layoutX="945.0" layoutY="560.0" prefHeight="18.0" prefWidth="102.0" />
                        <Button layoutX="1055.0" layoutY="560.0" mnemonicParsing="false" onAction="#sumMonth" text="-&gt;" />
                        <Button layoutX="910.0" layoutY="560.0" mnemonicParsing="false" onAction="#subtractMonth" text="&lt;-" />

                    </children>
                </AnchorPane>
            </content>
        </Tab>

    </tabs>
</TabPane>
