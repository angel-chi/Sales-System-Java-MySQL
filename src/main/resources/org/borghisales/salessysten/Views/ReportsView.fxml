<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #1e1e1e;"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.ReportsController">

    <top>
        <VBox style="-fx-background-color: #252526; -fx-padding: 10 20 10 20; -fx-border-color: #333; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="20">

                <Button fx:id="btnReturn" text="← VOLVER" onAction="#returnToMenu"
                        style="-fx-background-color: transparent; -fx-text-fill: #ffa726; -fx-border-color: #fb8c00; -fx-border-radius: 5;"/>

                <Label text="CENTRO DE REPORTES" textFill="WHITE">
                    <font><Font name="Segoe UI Semibold" size="22.0" /></font>
                    <effect><DropShadow color="#0000004d"/></effect>
                </Label>

            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #1e1e1e;">

            <Tab text="HISTORIAL DE VENTAS">
                <BorderPane style="-fx-background-color: #1e1e1e; -fx-padding: 20;">

                    <top>
                        <VBox spacing="10" style="-fx-padding: 0 0 15 0;">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="IMPORTE:" textFill="#dcdcdc" underline="true"><font><Font size="12"/></font></Label>
                                <TextField fx:id="minAmount" prefWidth="80" promptText="Min" style="-fx-background-color: #333; -fx-text-fill: white;"/>
                                <Label text="-" textFill="#dcdcdc"><font><Font size="18"/></font></Label>
                                <TextField fx:id="maxAmount" prefWidth="80" promptText="Max" style="-fx-background-color: #333; -fx-text-fill: white;"/>

                                <Region prefWidth="20"/>

                                <Label text="FECHA:" textFill="#dcdcdc" underline="true"><font><Font size="12"/></font></Label>
                                <DatePicker fx:id="minDate" prefWidth="110" promptText="Inicio"/>
                                <Label text="-" textFill="#dcdcdc"><font><Font size="18"/></font></Label>
                                <DatePicker fx:id="maxDate" prefWidth="110" promptText="Fin"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="btnFilter" text="FILTRAR" onAction="#onFilter" prefWidth="100" prefHeight="30" />
                            </HBox>
                        </VBox>
                    </top>

                    <center>
                        <TableView fx:id="tableReport" style="-fx-background-color: #2b2b2b; -fx-base: #2b2b2b; -fx-control-inner-background: #2b2b2b; -fx-table-cell-border-color: transparent;">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colIdSales" text="ID" maxWidth="50" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colNumberSales" text="FOLIO" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colSaleDate" text="FECHA" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colAmount" text="IMPORTE" style="-fx-alignment: CENTER-RIGHT;"/>
                                <TableColumn fx:id="colState" text="ESTADO" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colIdCustomer" text="ID CLI." maxWidth="60" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colIdSeller" text="ID VEND." maxWidth="60" style="-fx-alignment: CENTER;"/>
                            </columns>
                        </TableView>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 15 0 0 0;">
                            <ComboBox fx:id="cbTypeExport" prefWidth="100" style="-fx-background-color: #333; -fx-mark-color: white; -fx-text-base-color: white;"/>
                            <Button fx:id="btnExport" text="EXPORTAR" onAction="#onExport" prefWidth="100" prefHeight="32"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>

            <Tab text="ESTADÍSTICAS">
                <GridPane hgap="20" vgap="20" style="-fx-padding: 20; -fx-background-color: #1e1e1e;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="45"/>
                        <ColumnConstraints percentWidth="55"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS"/>
                    </rowConstraints>

                    <VBox spacing="10" alignment="TOP_CENTER" GridPane.columnIndex="0" style="-fx-background-color: #252526; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="VOLUMEN DE VENTAS" textFill="#dcdcdc" underline="true">
                            <font><Font size="18.0" /></font>
                        </Label>
                        <PieChart fx:id="pieChartProducts" legendVisible="true" legendSide="BOTTOM" labelsVisible="false" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox spacing="10" alignment="TOP_CENTER" GridPane.columnIndex="1" style="-fx-background-color: #252526; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="VENTAS POR PERIODO" textFill="#dcdcdc" underline="true">
                            <font><Font size="18.0" /></font>
                        </Label>

                        <LineChart fx:id="salesLineChart" createSymbols="false" legendVisible="false" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis fx:id="x_time" tickLabelFill="WHITE"/></xAxis>
                            <yAxis><NumberAxis fx:id="y_amountSales" side="LEFT" tickLabelFill="WHITE"/></yAxis>
                        </LineChart>

                        <GridPane hgap="10" vgap="5" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT"/>
                                <ColumnConstraints halignment="CENTER"/>
                                <ColumnConstraints halignment="CENTER"/>
                                <ColumnConstraints halignment="LEFT"/>
                            </columnConstraints>

                            <Label text="AÑO" textFill="#888" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

                            <Button fx:id="btnSubYear" text="&lt;" onAction="#subtractYear" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="year" editable="false" alignment="CENTER" prefWidth="80" style="-fx-background-color: #333; -fx-text-fill: white;" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
                            <Button fx:id="btnSumYear" text="&gt;" onAction="#sumYear" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                            <Region prefHeight="5" GridPane.rowIndex="2"/>

                            <Label text="MES" textFill="#888" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

                            <Button fx:id="btnSubMonth" text="&lt;" onAction="#subtractMonth" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="month" editable="false" alignment="CENTER" prefWidth="100" style="-fx-background-color: #333; -fx-text-fill: white;" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
                            <Button fx:id="btnSumMonth" text="&gt;" onAction="#sumMonth" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
                        </GridPane>
                    </VBox>
                </GridPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>