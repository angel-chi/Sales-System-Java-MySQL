<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!-- StackPane principal -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.borghisales.salessysten.controllers.ReportsController"
           prefHeight="900.0" prefWidth="1200.0">

    <!-- TabPane principal -->
    <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>

            <!-- Tab de Historial de Ventasd -->
            <Tab text="HISTORIAL DE VENTAS">
                <content>
                    <VBox spacing="15" alignment="TOP_CENTER">
                        <padding>
                            <Insets top="20" bottom="20" left="30" right="30"/>
                        </padding>

                        <!-- Header con logo y filtros -->
                        <HBox spacing="20" alignment="CENTER">
                            <ImageView fitHeight="87.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../../images/report.png" />
                                </image>
                            </ImageView>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Filtros -->
                            <VBox spacing="5" alignment="CENTER">
                                <Label text="CANTIDAD" underline="true">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                                <HBox spacing="5" alignment="CENTER">
                                    <TextField fx:id="minAmount" prefWidth="80.0" promptText="Mín"/>
                                    <Label text="-">
                                        <font>
                                            <Font size="20.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="maxAmount" prefWidth="80.0" promptText="Máx"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="5" alignment="CENTER">
                                <Label text="FECHA" underline="true">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                </Label>
                                <HBox spacing="5" alignment="CENTER">
                                    <DatePicker fx:id="minDate" prefWidth="120.0"/>
                                    <Label text="-">
                                        <font>
                                            <Font size="20.0" />
                                        </font>
                                    </Label>
                                    <DatePicker fx:id="maxDate" prefWidth="120.0"/>
                                </HBox>
                            </VBox>

                            <Button text="FILTRAR" onAction="#onFilter" prefWidth="94.0" prefHeight="32.0"/>
                        </HBox>

                        <!-- Tabla de reportes -->
                        <TableView fx:id="tableReport" prefHeight="650.0" prefWidth="1100.0">
                            <columns>
                                <TableColumn fx:id="colIdSales" prefWidth="157.0" text="IdVenta" />
                                <TableColumn fx:id="colIdCustomer" prefWidth="157.0" text="IdCliente" />
                                <TableColumn fx:id="colIdSeller" prefWidth="157.0" text="IdVendedor" />
                                <TableColumn fx:id="colNumberSales" prefWidth="157.0" text="# de Venta" />
                                <TableColumn fx:id="colSaleDate" prefWidth="157.0" text="Fecha de Venta" />
                                <TableColumn fx:id="colAmount" prefWidth="157.0" text="Cantidad" />
                                <TableColumn fx:id="colState" prefWidth="157.0" text="Estado" />
                            </columns>
                        </TableView>

                        <!-- Exportar -->
                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <ComboBox fx:id="cbTypeExport" prefWidth="108.0" style="-fx-alignment: CENTER;"/>
                            <Button text="EXPORTAR" onAction="#onExport" prefWidth="94.0" prefHeight="32.0"/>
                        </HBox>

                    </VBox>
                </content>
            </Tab>

            <!-- Tab: Estadísticas -->
            <Tab text="ESTADÍSTICAS">
                <content>
                    <VBox spacing="15" alignment="TOP_CENTER">
                        <padding>
                            <Insets top="20" bottom="20" left="30" right="30"/>
                        </padding>

                        <!-- Títulos de las gráficas -->
                        <HBox spacing="50" alignment="CENTER">
                            <Label text="CANTIDAD DE PRODUCTOS VENDIDOS" underline="true">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                            <Label text="VENTAS A LO LARGO DEL TIEMPO" underline="true">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </HBox>

                        <!-- Gráficas lado a lado -->
                        <HBox spacing="20" alignment="CENTER">
                            <!-- PieChart -->
                            <PieChart fx:id="pieChartProducts" prefHeight="500.0" prefWidth="550.0"/>

                            <!-- LineChart -->
                            <LineChart fx:id="salesLineChart" createSymbols="false" legendVisible="false" prefHeight="500.0" prefWidth="550.0">
                                <xAxis>
                                    <CategoryAxis side="BOTTOM" fx:id="x_time" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="y_amountSales" side="LEFT" />
                                </yAxis>
                            </LineChart>
                        </HBox>

                        <!-- Controles de año y mes -->
                        <HBox spacing="40" alignment="CENTER">
                            <!-- Selector de año -->
                            <VBox spacing="10" alignment="CENTER">
                                <Label text="AÑO" underline="true">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <HBox spacing="10" alignment="CENTER">
                                    <Button text="&lt;-" onAction="#subtractYear"/>
                                    <TextField fx:id="year" alignment="CENTER" editable="false" prefWidth="80.0"/>
                                    <Button text="-&gt;" onAction="#sumYear"/>
                                </HBox>
                            </VBox>

                            <!-- Selector de mes -->
                            <VBox spacing="10" alignment="CENTER">
                                <Label text="MES" underline="true">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <HBox spacing="10" alignment="CENTER">
                                    <Button text="&lt;-" onAction="#subtractMonth"/>
                                    <TextField fx:id="month" alignment="CENTER" editable="false" prefWidth="80.0"/>
                                    <Button text="-&gt;" onAction="#sumMonth"/>
                                </HBox>
                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </Tab>

        </tabs>
    </TabPane>

</StackPane>