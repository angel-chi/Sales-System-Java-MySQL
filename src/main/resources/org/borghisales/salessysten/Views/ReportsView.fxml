<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<TabPane tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.borghisales.salessysten.controllers.ReportsController">
    <tabs>
        <Tab text="HISTORIAL DE VENTAS">
            <content>
                <BorderPane>
                    <top>
                        <VBox spacing="15" alignment="CENTER" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="20" right="20" bottom="10" left="20"/>
                            </padding>


                            <HBox spacing="15" alignment="CENTER">
                                <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                                    <Image url="@../../../../images/report.png"/>
                                </ImageView>
                                <Label text="REPORTES DE VENTAS" underline="true">
                                    <font><Font size="24"/></font>
                                </Label>
                            </HBox>

                            <Separator/>


                            <HBox spacing="15" alignment="CENTER">

                                <VBox spacing="5" alignment="CENTER">
                                    <Label text="MONTO" underline="true">
                                        <font><Font size="15"/></font>
                                    </Label>
                                    <HBox spacing="5" alignment="CENTER">
                                        <TextField fx:id="minAmount" prefWidth="100" promptText="Mínimo"/>
                                        <Label text="-">
                                            <font><Font size="20"/></font>
                                        </Label>
                                        <TextField fx:id="maxAmount" prefWidth="100" promptText="Máximo"/>
                                    </HBox>
                                </VBox>


                                <VBox spacing="5" alignment="CENTER">
                                    <Label text="FECHA" underline="true">
                                        <font><Font size="15"/></font>
                                    </Label>
                                    <HBox spacing="5" alignment="CENTER">
                                        <DatePicker fx:id="minDate" prefWidth="130" promptText="Desde"/>
                                        <Label text="-">
                                            <font><Font size="20"/></font>
                                        </Label>
                                        <DatePicker fx:id="maxDate" prefWidth="130" promptText="Hasta"/>
                                    </HBox>
                                </VBox>

                                <Button text="FILTRAR" onAction="#onFilter" prefWidth="120" prefHeight="35">
                                    <font><Font size="14"/></font>
                                </Button>
                            </HBox>

                            <Separator/>
                        </VBox>
                    </top>


                    <center>
                        <VBox spacing="10" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="10" right="20" bottom="20" left="20"/>
                            </padding>

                            <TableView fx:id="tableReport" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colIdSales" text="ID Venta" prefWidth="100"/>
                                    <TableColumn fx:id="colIdCustomer" text="ID Cliente" prefWidth="100"/>
                                    <TableColumn fx:id="colIdSeller" text="ID Vendedor" prefWidth="120"/>
                                    <TableColumn fx:id="colNumberSales" text="N° Venta" prefWidth="120"/>
                                    <TableColumn fx:id="colSaleDate" text="Fecha" prefWidth="120"/>
                                    <TableColumn fx:id="colAmount" text="Monto" prefWidth="120"/>
                                    <TableColumn fx:id="colState" text="Estado" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </center>

                    <bottom>
                        <HBox spacing="15" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="10" right="20" bottom="20" left="20"/>
                            </padding>

                            <Label text="EXPORTAR COMO:">
                                <font><Font size="14"/></font>
                            </Label>
                            <ComboBox fx:id="cbTypeExport" prefWidth="150" style="-fx-alignment: CENTER;"/>
                            <Button text="EXPORTAR" onAction="#onExport" prefWidth="120" prefHeight="35">
                                <font><Font size="14"/></font>
                            </Button>
                        </HBox>
                    </bottom>
                </BorderPane>
            </content>
        </Tab>

        <Tab text="ESTADÍSTICAS">
            <content>
                <BorderPane>

                    <top>
                        <VBox spacing="15" alignment="CENTER" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="20" bottom="15"/>
                            </padding>

                            <Label text="ESTADÍSTICAS DE VENTAS" underline="true">
                                <font><Font size="26"/></font>
                            </Label>

                            <Separator/>
                        </VBox>
                    </top>

                    <center>
                        <HBox spacing="20" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="10" right="20" bottom="20" left="20"/>
                            </padding>


                            <VBox spacing="10" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                <Label text="CANTIDAD DE PRODUCTOS VENDIDOS" underline="true">
                                    <font><Font size="18"/></font>
                                </Label>
                                <PieChart fx:id="pieChartProducts" VBox.vgrow="ALWAYS"
                                          minHeight="400" minWidth="400"/>
                            </VBox>

                            <!-- Gráfico de líneas -->
                            <VBox spacing="10" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                <Label text="VENTAS A LO LARGO DEL TIEMPO" underline="true">
                                    <font><Font size="18"/></font>
                                </Label>
                                <LineChart fx:id="salesLineChart" createSymbols="false"
                                           legendVisible="false" VBox.vgrow="ALWAYS"
                                           minHeight="400" minWidth="500">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM" fx:id="x_time"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="y_amountSales" side="LEFT"/>
                                    </yAxis>
                                </LineChart>
                            </VBox>
                        </HBox>
                    </center>

                    <bottom>
                        <VBox spacing="15" alignment="CENTER" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets top="15" right="20" bottom="20" left="20"/>
                            </padding>

                            <Separator/>

                            <HBox spacing="30" alignment="CENTER">

                                <VBox spacing="10" alignment="CENTER">
                                    <Label text="AÑO" underline="true">
                                        <font><Font size="20"/></font>
                                    </Label>
                                    <HBox spacing="10" alignment="CENTER">
                                        <Button text="&lt;-" onAction="#subtractYear" prefWidth="50" prefHeight="35"/>
                                        <TextField fx:id="year" alignment="CENTER" editable="false"
                                                   prefWidth="100" prefHeight="35">
                                            <font><Font size="16"/></font>
                                        </TextField>
                                        <Button text="-&gt;" onAction="#sumYear" prefWidth="50" prefHeight="35"/>
                                    </HBox>
                                </VBox>


                                <VBox spacing="10" alignment="CENTER">
                                    <Label text="MES" underline="true">
                                        <font><Font size="20"/></font>
                                    </Label>
                                    <HBox spacing="10" alignment="CENTER">
                                        <Button text="&lt;-" onAction="#subtractMonth" prefWidth="50" prefHeight="35"/>
                                        <TextField fx:id="month" alignment="CENTER" editable="false"
                                                   prefWidth="100" prefHeight="35">
                                            <font><Font size="16"/></font>
                                        </TextField>
                                        <Button text="-&gt;" onAction="#sumMonth" prefWidth="50" prefHeight="35"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </bottom>
                </BorderPane>
            </content>
        </Tab>
    </tabs>
</TabPane>