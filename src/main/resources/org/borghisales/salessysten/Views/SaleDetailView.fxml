<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="799.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.borghisales.salessysten.controllers.SaleDetailController">
    <center>
        <TableView fx:id="tableSale" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNro" prefWidth="100.0" sortable="false" style="-fx-alignment: CENTER;" text="NUMERO" />
                <TableColumn fx:id="colCod" prefWidth="100.0" sortable="false" style="-fx-alignment: CENTER;" text="CÓDIGO" />
                <TableColumn fx:id="colProduct" prefWidth="350.0" sortable="false" style="-fx-alignment: CENTER;" text="PRODUCTO" />
                <TableColumn fx:id="colQuantity" minWidth="0.0" prefWidth="103.0" style="-fx-alignment: CENTER;" text="CANTIDAD" />
                <TableColumn fx:id="colPrice" prefWidth="150.0" style="-fx-alignment: CENTER;" text="PRECIO POR UNIDAD." />
                <TableColumn fx:id="colTotal" prefWidth="100.0" style="-fx-alignment: CENTER;" text="TOTAL" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="TOTAL VENTA:" />
                <TextField fx:id="totalSale" editable="false" prefWidth="120.0" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>